{
  "name": "realmflow",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first SDLC desktop workspace",
  "main": "out/main/main.js",
  "type": "module",
  "scripts": {
    "dev": "npm run rebuild:native && node scripts/dev.mjs",
    "build": "npm run verify:builtin-catalog && npm run verify:css-usage && npm run verify:component-system && npm run typecheck && electron-vite build",
    "benchmark:knowledge": "node scripts/benchmark-knowledge-search.mjs",
    "download:gte-model": "node scripts/fetch-gte-model.mjs",
    "download:qdrant": "node scripts/download-qdrant.mjs",
    "generate:builtin-catalog": "node scripts/generate-builtin-extension-catalog.mjs",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3,node-pty",
    "rebuild:test-native": "npm rebuild better-sqlite3 node-pty",
    "verify:sqlite": "electron scripts/verify-electron-sqlite.cjs",
    "verify:builtin-catalog": "node scripts/verify-builtin-extension-catalog.mjs",
    "verify:component-system": "node scripts/verify-component-system.mjs",
    "verify:css-usage": "node scripts/report-unused-css.mjs --check",
    "verify:gte-model": "node scripts/verify-gte-model.mjs",
    "verify:gte-manifest": "node scripts/verify-gte-model.mjs --manifest-only",
    "verify:knowledge-benchmark": "node scripts/verify-knowledge-benchmark.mjs",
    "verify:qdrant-assets": "node scripts/verify-qdrant-assets.mjs",
    "verify:qdrant-manifest": "node scripts/verify-qdrant-assets.mjs --all --manifest-only",
    "dist": "npm run dist:mac",
    "dist:mac": "npm run verify:qdrant-assets && npm run verify:gte-model && bash scripts/build-mac-installer.sh",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "npm run rebuild:test-native && vitest run",
    "test:watch": "npm run rebuild:test-native && vitest"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@earendil-works/pi-ai": "0.80.10",
    "@file-viewer/core": "3.1.2",
    "@file-viewer/renderer-ofd": "3.1.2",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@monaco-editor/react": "^4.7.0",
    "@napi-rs/canvas": "^0.1.100",
    "@tanstack/react-virtual": "^3.14.13",
    "@tesseract.js-data/chi_sim": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/extension-link": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.12.0",
    "ajv": "^8.20.0",
    "better-sqlite3": "^11.10.0",
    "cron-parser": "^5.10.1",
    "extract-zip": "^2.0.1",
    "fast-xml-parser": "^5.3.0",
    "html2canvas": "^1.4.1",
    "jszip": "^3.10.2",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.13.0",
    "monaco-editor": "^0.56.0",
    "node-pty": "^1.1.0",
    "parse5": "^7.3.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "prism-react-renderer": "^2.4.1",
    "prismjs": "^1.30.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.3",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sharp": "0.34.4",
    "smol-toml": "^1.4.2",
    "tar": "7.5.22",
    "tesseract.js": "7.0.0",
    "yaml": "^2.9.0",
    "yauzl": "2.10.0"
  },
  "overrides": {
    "dompurify": "3.4.16"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/dagre": "^0.7.54",
    "@types/node": "^20.17.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/yauzl": "2.10.3",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "30.5.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.29",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
