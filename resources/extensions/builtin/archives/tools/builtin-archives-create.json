{
  "schemaVersion": 1,
  "id": "builtin.archives.create",
  "version": "1.1.0",
  "name": "Create archive",
  "description": "Create a new local archive from authorized files and directories.",
  "tags": [
    "archives"
  ],
  "executor": {
    "kind": "builtin",
    "handler": "archives.create",
    "handlerVersion": "1.0.0"
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "outputPath",
      "sources",
      "expectedAbsent"
    ],
    "properties": {
      "outputPath": {
        "type": "string",
        "minLength": 1,
        "description": "Authorized new output path as a relative path under the authorized root; it must not overwrite existing content. Do not invent or pass absolute local paths.",
        "examples": [
          "exports/result.pdf"
        ]
      },
      "expectedAbsent": {
        "type": "boolean",
        "const": true,
        "description": "Must be true to confirm the target path does not already exist.",
        "examples": [
          true
        ]
      },
      "sources": {
        "type": "array",
        "minItems": 1,
        "maxItems": 100,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "expectedChecksum"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "description": "Authorized local path as a relative path under the authorized root. Do not invent or pass absolute local paths.",
              "examples": [
                "docs/example.md"
              ]
            },
            "expectedChecksum": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$",
              "description": "SHA-256 checksum of the authorized prior file content.",
              "examples": [
                "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
              ]
            }
          },
          "examples": [
            [
              {
                "path": "docs/source.md",
                "expectedChecksum": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
              }
            ]
          ]
        },
        "description": "Authorized archive source files or directories with expected checksums.",
        "examples": [
          [
            {
              "path": "docs/source.md",
              "expectedChecksum": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
            }
          ]
        ]
      },
      "scopeRoot": {
        "type": "string",
        "minLength": 1,
        "description": "Optional authorized root override. Omit or pass \".\" to use the current authorized root.",
        "examples": [
          "."
        ]
      }
    },
    "examples": [
      {
        "outputPath": "exports/result.pdf",
        "expectedAbsent": true,
        "sources": [
          {
            "path": "docs/source.md",
            "expectedChecksum": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
          }
        ],
        "scopeRoot": "."
      }
    ]
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": true
  },
  "capabilities": [
    "filesystem.write"
  ],
  "effects": [
    "local_data.change"
  ],
  "risk": "medium",
  "invocation": {
    "mode": "unary",
    "idempotency": "supported",
    "cancellable": true,
    "resumable": false
  },
  "resources": {
    "timeoutMs": 120000,
    "maxOutputBytes": 4194304,
    "maxAttempts": 1
  },
  "discovery": {
    "intents": [
      "create archive"
    ],
    "contexts": [
      "general",
      "space",
      "requirement",
      "workflow",
      "schedule"
    ]
  }
}
