{
  "schemaVersion": 1,
  "id": "builtin.archives.extract",
  "version": "1.1.0",
  "name": "Extract archive",
  "description": "Safely extract an authorized archive into a new local directory.",
  "tags": [
    "archives"
  ],
  "executor": {
    "kind": "builtin",
    "handler": "archives.extract",
    "handlerVersion": "1.0.0"
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "path",
      "expectedChecksum",
      "outputPath",
      "expectedAbsent"
    ],
    "properties": {
      "path": {
        "type": "string",
        "minLength": 1
      },
      "expectedChecksum": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "outputPath": {
        "type": "string",
        "minLength": 1
      },
      "expectedAbsent": {
        "type": "boolean",
        "const": true
      },
      "scopeRoot": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": true
  },
  "capabilities": [
    "filesystem.write"
  ],
  "effects": [
    "local_data.change"
  ],
  "risk": "medium",
  "invocation": {
    "mode": "unary",
    "idempotency": "supported",
    "cancellable": true,
    "resumable": false
  },
  "resources": {
    "timeoutMs": 120000,
    "maxOutputBytes": 4194304,
    "maxAttempts": 1
  },
  "discovery": {
    "intents": [
      "extract archive"
    ],
    "contexts": [
      "general",
      "space",
      "requirement",
      "workflow",
      "schedule"
    ]
  }
}
