{
  "schemaVersion": 1,
  "id": "builtin.pdf.ocr",
  "version": "1.0.2",
  "name": "Recognize PDF page text",
  "description": "Render and recognize one scanned PDF page locally.",
  "tags": [
    "pdf"
  ],
  "executor": {
    "kind": "builtin",
    "handler": "pdf.ocr",
    "handlerVersion": "1.0.0"
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "sessionId": {
        "type": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f-]{27,}$",
        "description": "Stable local editing or browser session ID returned by an inspect/create tool.",
        "examples": [
          "12345678-1234-4234-9234-123456789abc"
        ]
      },
      "expectedRevision": {
        "type": "integer",
        "minimum": 0,
        "description": "Expected revision used for optimistic concurrency control. Copy this value from the latest RealmFlow UI/API state; do not invent it.",
        "examples": [
          1
        ]
      },
      "pageNumber": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100000,
        "description": "One-based page number.",
        "examples": [
          1
        ]
      },
      "maxDimension": {
        "type": "integer",
        "minimum": 64,
        "maximum": 2048,
        "description": "Maximum rendered image dimension in pixels.",
        "examples": [
          1024
        ]
      },
      "language": {
        "type": "string",
        "minLength": 2,
        "maxLength": 32,
        "pattern": "^[A-Za-z0-9_-]+$",
        "description": "Language or locale code used by OCR, search, or content processing.",
        "examples": [
          "eng"
        ]
      }
    },
    "required": [
      "sessionId",
      "pageNumber"
    ],
    "examples": [
      {
        "sessionId": "12345678-1234-4234-9234-123456789abc",
        "expectedRevision": 1,
        "pageNumber": 1,
        "maxDimension": 1024,
        "language": "eng"
      }
    ]
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": true
  },
  "capabilities": [
    "filesystem.read"
  ],
  "effects": [
    "local_data.read"
  ],
  "risk": "low",
  "invocation": {
    "mode": "unary",
    "idempotency": "supported",
    "cancellable": true,
    "resumable": false
  },
  "resources": {
    "timeoutMs": 120000,
    "maxOutputBytes": 4194304,
    "maxAttempts": 1
  },
  "discovery": {
    "intents": [
      "recognize pdf page text"
    ],
    "contexts": [
      "general",
      "space",
      "requirement",
      "workflow",
      "schedule"
    ]
  }
}
