{
  "schemaVersion": 1,
  "id": "builtin.pdf.watermark",
  "version": "1.0.1",
  "name": "Watermark PDF pages",
  "description": "Draw a text watermark on explicit PDF pages.",
  "tags": [
    "pdf"
  ],
  "executor": {
    "kind": "builtin",
    "handler": "pdf.watermark",
    "handlerVersion": "1.0.0"
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "sessionId": {
        "type": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f-]{27,}$",
        "description": "Stable local editing or browser session ID returned by an inspect/create tool.",
        "examples": [
          "12345678-1234-4234-9234-123456789abc"
        ]
      },
      "expectedRevision": {
        "type": "integer",
        "minimum": 0,
        "description": "Expected revision used for optimistic concurrency control. Copy this value from the latest RealmFlow UI/API state; do not invent it.",
        "examples": [
          1
        ]
      },
      "pageNumbers": {
        "type": "array",
        "minItems": 1,
        "maxItems": 10000,
        "uniqueItems": false,
        "items": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000,
          "examples": [
            [
              1
            ]
          ]
        },
        "description": "One-based page numbers affected by the PDF operation.",
        "examples": [
          [
            1
          ]
        ]
      },
      "text": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500,
        "description": "Text content used by the requested operation.",
        "examples": [
          "Example text."
        ]
      },
      "fontSize": {
        "type": "number",
        "minimum": 6,
        "maximum": 200,
        "description": "Font size in points for the generated PDF watermark.",
        "examples": [
          6
        ]
      },
      "opacity": {
        "type": "number",
        "minimum": 0.05,
        "maximum": 1,
        "description": "Watermark opacity from transparent to opaque.",
        "examples": [
          0.5
        ]
      },
      "angle": {
        "type": "number",
        "minimum": -180,
        "maximum": 180,
        "description": "Rotation angle in degrees.",
        "examples": [
          -180
        ]
      }
    },
    "required": [
      "sessionId",
      "expectedRevision",
      "pageNumbers",
      "text"
    ],
    "examples": [
      {
        "sessionId": "12345678-1234-4234-9234-123456789abc",
        "expectedRevision": 1,
        "pageNumbers": [
          1
        ],
        "text": "Example text.",
        "fontSize": 6,
        "opacity": 0.5,
        "angle": -180
      }
    ]
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": true
  },
  "capabilities": [
    "filesystem.write"
  ],
  "effects": [
    "local_data.change"
  ],
  "risk": "medium",
  "invocation": {
    "mode": "unary",
    "idempotency": "supported",
    "cancellable": true,
    "resumable": false
  },
  "resources": {
    "timeoutMs": 120000,
    "maxOutputBytes": 4194304,
    "maxAttempts": 1
  },
  "discovery": {
    "intents": [
      "watermark pdf pages"
    ],
    "contexts": [
      "general",
      "space",
      "requirement",
      "workflow",
      "schedule"
    ]
  }
}
