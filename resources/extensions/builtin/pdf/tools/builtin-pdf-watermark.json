{
  "schemaVersion": 1,
  "id": "builtin.pdf.watermark",
  "version": "1.0.1",
  "name": "Watermark PDF pages",
  "description": "Draw a text watermark on explicit PDF pages.",
  "tags": [
    "pdf"
  ],
  "executor": {
    "kind": "builtin",
    "handler": "pdf.watermark",
    "handlerVersion": "1.0.0"
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "sessionId": {
        "type": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f-]{27,}$"
      },
      "expectedRevision": {
        "type": "integer",
        "minimum": 0
      },
      "pageNumbers": {
        "type": "array",
        "minItems": 1,
        "maxItems": 10000,
        "uniqueItems": false,
        "items": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        }
      },
      "text": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "fontSize": {
        "type": "number",
        "minimum": 6,
        "maximum": 200
      },
      "opacity": {
        "type": "number",
        "minimum": 0.05,
        "maximum": 1
      },
      "angle": {
        "type": "number",
        "minimum": -180,
        "maximum": 180
      }
    },
    "required": [
      "sessionId",
      "expectedRevision",
      "pageNumbers",
      "text"
    ]
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": true
  },
  "capabilities": [
    "filesystem.write"
  ],
  "effects": [
    "local_data.change"
  ],
  "risk": "medium",
  "invocation": {
    "mode": "unary",
    "idempotency": "supported",
    "cancellable": true,
    "resumable": false
  },
  "resources": {
    "timeoutMs": 120000,
    "maxOutputBytes": 4194304,
    "maxAttempts": 1
  },
  "discovery": {
    "intents": [
      "watermark pdf pages"
    ],
    "contexts": [
      "general",
      "space",
      "requirement",
      "workflow",
      "schedule"
    ]
  }
}
