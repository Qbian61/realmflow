{
  "schemaVersion": 1,
  "id": "builtin.pdf.rotate",
  "version": "1.0.1",
  "name": "Rotate PDF pages",
  "description": "Rotate explicit PDF pages by quarter turns.",
  "tags": [
    "pdf"
  ],
  "executor": {
    "kind": "builtin",
    "handler": "pdf.rotate",
    "handlerVersion": "1.0.0"
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "sessionId": {
        "type": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f-]{27,}$",
        "description": "Stable local editing or browser session ID returned by an inspect/create tool.",
        "examples": [
          "12345678-1234-4234-9234-123456789abc"
        ]
      },
      "expectedRevision": {
        "type": "integer",
        "minimum": 0,
        "description": "Expected revision used for optimistic concurrency control. Copy this value from the latest RealmFlow UI/API state; do not invent it.",
        "examples": [
          1
        ]
      },
      "pageNumbers": {
        "type": "array",
        "minItems": 1,
        "maxItems": 10000,
        "uniqueItems": false,
        "items": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000,
          "examples": [
            [
              1
            ]
          ]
        },
        "description": "One-based page numbers affected by the PDF operation.",
        "examples": [
          [
            1
          ]
        ]
      },
      "angle": {
        "type": "integer",
        "enum": [
          90,
          180,
          270
        ],
        "description": "Rotation angle in degrees. Allowed values: 90, 180, 270.",
        "examples": [
          90
        ]
      }
    },
    "required": [
      "sessionId",
      "expectedRevision",
      "pageNumbers",
      "angle"
    ],
    "examples": [
      {
        "sessionId": "12345678-1234-4234-9234-123456789abc",
        "expectedRevision": 1,
        "pageNumbers": [
          1
        ],
        "angle": 90
      }
    ]
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": true
  },
  "capabilities": [
    "filesystem.write"
  ],
  "effects": [
    "local_data.change"
  ],
  "risk": "medium",
  "invocation": {
    "mode": "unary",
    "idempotency": "supported",
    "cancellable": true,
    "resumable": false
  },
  "resources": {
    "timeoutMs": 120000,
    "maxOutputBytes": 4194304,
    "maxAttempts": 1
  },
  "discovery": {
    "intents": [
      "rotate pdf pages"
    ],
    "contexts": [
      "general",
      "space",
      "requirement",
      "workflow",
      "schedule"
    ]
  }
}
