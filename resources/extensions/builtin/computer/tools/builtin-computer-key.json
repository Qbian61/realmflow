{
  "schemaVersion": 1,
  "id": "builtin.computer.key",
  "version": "1.0.0",
  "name": "Press key",
  "description": "Send a controlled key chord.",
  "tags": [
    "computer"
  ],
  "executor": {
    "kind": "computer",
    "actionSet": "key",
    "actionSetVersion": "1.0.0"
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "bundleId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]{1,199}$",
        "description": "macOS application bundle identifier for the authorized target app.",
        "examples": [
          "com.realmflow.App"
        ]
      },
      "key": {
        "type": "string",
        "enum": [
          "return",
          "tab",
          "space",
          "delete",
          "escape",
          "left",
          "right",
          "down",
          "up"
        ],
        "description": "Keyboard key sent to the authorized target. Allowed values: return, tab, space, delete, escape, left, right, down, up.",
        "examples": [
          "return"
        ]
      },
      "modifiers": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "command",
            "control",
            "option",
            "shift"
          ],
          "examples": [
            "command"
          ]
        },
        "uniqueItems": true,
        "maxItems": 4,
        "description": "Keyboard modifier keys sent with the key press.",
        "examples": [
          [
            "command"
          ]
        ]
      }
    },
    "required": [
      "bundleId",
      "key"
    ],
    "examples": [
      {
        "bundleId": "com.realmflow.App",
        "key": "return",
        "modifiers": [
          "command"
        ]
      }
    ]
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": true
  },
  "capabilities": [
    "computer.control"
  ],
  "effects": [
    "user_interface.change"
  ],
  "risk": "high",
  "invocation": {
    "mode": "unary",
    "idempotency": "supported",
    "cancellable": true,
    "resumable": false
  },
  "resources": {
    "timeoutMs": 120000,
    "maxOutputBytes": 4194304,
    "maxAttempts": 1
  },
  "discovery": {
    "intents": [
      "press key"
    ],
    "contexts": [
      "general",
      "space",
      "requirement",
      "workflow",
      "schedule"
    ]
  }
}
