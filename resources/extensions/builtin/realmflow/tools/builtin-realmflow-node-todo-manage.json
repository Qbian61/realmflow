{
  "schemaVersion": 1,
  "id": "builtin.realmflow.node.todo.manage",
  "version": "1.0.3",
  "name": "Manage node Todo",
  "description": "Create, complete, or delete a NodeRun Todo.",
  "tags": [
    "realmflow"
  ],
  "executor": {
    "kind": "builtin",
    "handler": "realmflow.node.todo.manage",
    "handlerVersion": "1.0.0"
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "operation",
      "id",
      "expectedRevision"
    ],
    "properties": {
      "operation": {
        "type": "string",
        "enum": [
          "save",
          "delete"
        ],
        "description": "Mutation operation to perform. Allowed values: save, delete.",
        "examples": [
          "save"
        ]
      },
      "id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "description": "Stable RealmFlow entity ID for the requested operation.",
        "examples": [
          "item-1"
        ]
      },
      "nodeRunId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "description": "Stable NodeRun ID that owns the question, todo, or approval.",
        "examples": [
          "node-run-1"
        ]
      },
      "title": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500,
        "description": "User-visible title.",
        "examples": [
          "Quarterly update"
        ]
      },
      "required": {
        "type": "boolean",
        "description": "Whether the todo is required before the node can complete.",
        "examples": [
          true
        ]
      },
      "status": {
        "type": "string",
        "enum": [
          "pending",
          "in_progress",
          "completed",
          "blocked",
          "cancelled"
        ],
        "description": "Target workflow, todo, requirement, or question status. Allowed values: pending, in_progress, completed, blocked, cancelled.",
        "examples": [
          "pending"
        ]
      },
      "reason": {
        "type": "string",
        "maxLength": 1000,
        "description": "Short reason recorded for the state change.",
        "examples": [
          "User requested this state change."
        ]
      },
      "expectedRevision": {
        "type": "integer",
        "minimum": 0,
        "description": "Expected revision used for optimistic concurrency control. Copy this value from the latest RealmFlow UI/API state; do not invent it.",
        "examples": [
          1
        ]
      }
    },
    "examples": [
      {
        "operation": "save",
        "id": "item-1",
        "nodeRunId": "node-run-1",
        "title": "Quarterly update",
        "required": true,
        "status": "pending",
        "reason": "User requested this state change.",
        "expectedRevision": 1
      }
    ]
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": true
  },
  "capabilities": [
    "realmflow.write"
  ],
  "effects": [
    "local_data.change"
  ],
  "risk": "medium",
  "invocation": {
    "mode": "unary",
    "idempotency": "supported",
    "cancellable": true,
    "resumable": false
  },
  "resources": {
    "timeoutMs": 120000,
    "maxOutputBytes": 4194304,
    "maxAttempts": 1
  },
  "discovery": {
    "intents": [
      "manage node todo"
    ],
    "contexts": [
      "general",
      "space",
      "requirement",
      "workflow",
      "schedule"
    ]
  }
}
