{
  "schemaVersion": 1,
  "id": "builtin.web.search",
  "version": "1.1.1",
  "name": "Search web",
  "description": "Search using the provider saved in Web settings (self-hosted SearXNG or opt-in Brave); return source-attributed results. Provider selection and credentials are controlled by the user.",
  "tags": [
    "web"
  ],
  "executor": {
    "kind": "builtin",
    "handler": "web.search",
    "handlerVersion": "1.0.0"
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "query"
    ],
    "properties": {
      "query": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500,
        "description": "Search or match query supplied by the user or current task.",
        "examples": [
          "release notes"
        ]
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 20,
        "description": "Maximum number of bytes or results returned by the operation.",
        "examples": [
          1
        ]
      },
      "language": {
        "type": "string",
        "minLength": 2,
        "maxLength": 16,
        "description": "Language or locale code used by OCR, search, or content processing.",
        "examples": [
          "en"
        ]
      },
      "locale": {
        "type": "string",
        "minLength": 2,
        "maxLength": 32,
        "description": "Search locale such as en-US or zh-CN used by the configured web search provider.",
        "examples": [
          "example"
        ]
      },
      "recency": {
        "type": "string",
        "enum": [
          "day",
          "week",
          "month",
          "year",
          "any"
        ],
        "description": "Optional search freshness filter. Allowed values: day, week, month, year, any.",
        "examples": [
          "day"
        ]
      },
      "safeSearch": {
        "type": "string",
        "enum": [
          "strict",
          "moderate",
          "off"
        ],
        "description": "Safe-search preference passed to the configured web search provider. Allowed values: strict, moderate, off.",
        "examples": [
          "strict"
        ]
      }
    },
    "examples": [
      {
        "query": "release notes",
        "limit": 1,
        "language": "en",
        "locale": "example",
        "recency": "day",
        "safeSearch": "strict"
      }
    ]
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": true
  },
  "capabilities": [
    "network.connect",
    "credential.use"
  ],
  "effects": [
    "external.read",
    "local_data.read"
  ],
  "risk": "medium",
  "invocation": {
    "mode": "unary",
    "idempotency": "supported",
    "cancellable": true,
    "resumable": false
  },
  "resources": {
    "timeoutMs": 120000,
    "maxOutputBytes": 4194304,
    "maxAttempts": 1
  },
  "discovery": {
    "intents": [
      "search web"
    ],
    "contexts": [
      "general",
      "space",
      "requirement",
      "workflow",
      "schedule"
    ]
  }
}
