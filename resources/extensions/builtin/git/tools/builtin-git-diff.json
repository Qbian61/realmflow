{
  "schemaVersion": 1,
  "id": "builtin.git.diff",
  "version": "1.0.1",
  "name": "Git diff",
  "description": "Read staged or unstaged differences.",
  "tags": [
    "git"
  ],
  "executor": {
    "kind": "builtin",
    "handler": "git.diff",
    "handlerVersion": "1.0.0"
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "scopeRoot": {
        "type": "string",
        "minLength": 1,
        "description": "Optional authorized root override. Omit or pass \".\" to use the current authorized root.",
        "examples": [
          "."
        ]
      },
      "staged": {
        "type": "boolean",
        "description": "Whether to inspect staged Git changes instead of unstaged changes.",
        "examples": [
          false
        ]
      },
      "path": {
        "type": "string",
        "minLength": 1,
        "description": "Authorized local path as a relative path under the authorized root. Do not invent or pass absolute local paths.",
        "examples": [
          "docs/example.md"
        ]
      }
    },
    "examples": [
      {
        "scopeRoot": ".",
        "staged": false,
        "path": "docs/example.md"
      }
    ]
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": true
  },
  "capabilities": [
    "repository.read"
  ],
  "effects": [
    "local_data.read"
  ],
  "risk": "low",
  "invocation": {
    "mode": "unary",
    "idempotency": "supported",
    "cancellable": true,
    "resumable": false
  },
  "resources": {
    "timeoutMs": 120000,
    "maxOutputBytes": 4194304,
    "maxAttempts": 1
  },
  "discovery": {
    "intents": [
      "git diff"
    ],
    "contexts": [
      "general",
      "space",
      "requirement",
      "workflow",
      "schedule"
    ]
  }
}
