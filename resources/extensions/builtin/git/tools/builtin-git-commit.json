{
  "schemaVersion": 1,
  "id": "builtin.git.commit",
  "version": "1.0.1",
  "name": "Create commit",
  "description": "Create a new commit from explicitly selected files.",
  "tags": [
    "git"
  ],
  "executor": {
    "kind": "builtin",
    "handler": "git.commit",
    "handlerVersion": "1.0.0"
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "message",
      "files"
    ],
    "properties": {
      "scopeRoot": {
        "type": "string",
        "minLength": 1
      },
      "message": {
        "type": "string",
        "minLength": 1,
        "maxLength": 10000
      },
      "files": {
        "type": "array",
        "minItems": 1,
        "maxItems": 1000,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": true
  },
  "capabilities": [
    "repository.modify"
  ],
  "effects": [
    "repository.change"
  ],
  "risk": "high",
  "invocation": {
    "mode": "unary",
    "idempotency": "supported",
    "cancellable": true,
    "resumable": false
  },
  "resources": {
    "timeoutMs": 120000,
    "maxOutputBytes": 4194304,
    "maxAttempts": 1
  },
  "discovery": {
    "intents": [
      "create commit"
    ],
    "contexts": [
      "general",
      "space",
      "requirement",
      "workflow",
      "schedule"
    ]
  }
}
