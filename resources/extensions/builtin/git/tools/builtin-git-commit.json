{
  "schemaVersion": 1,
  "id": "builtin.git.commit",
  "version": "1.0.2",
  "name": "Create commit",
  "description": "Create a new commit from explicitly selected files.",
  "tags": [
    "git"
  ],
  "executor": {
    "kind": "builtin",
    "handler": "git.commit",
    "handlerVersion": "1.0.0"
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "message",
      "files"
    ],
    "properties": {
      "scopeRoot": {
        "type": "string",
        "minLength": 1,
        "description": "Optional authorized root override. Omit or pass \".\" to use the current authorized root.",
        "examples": [
          "."
        ]
      },
      "message": {
        "type": "string",
        "minLength": 1,
        "maxLength": 10000,
        "description": "Commit message or user-visible operation message.",
        "examples": [
          "chore: update generated artifact"
        ]
      },
      "files": {
        "type": "array",
        "minItems": 1,
        "maxItems": 1000,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1,
          "examples": [
            [
              "src/index.ts"
            ]
          ]
        },
        "description": "Explicit repository file paths to include in the commit.",
        "examples": [
          [
            "src/index.ts"
          ]
        ]
      }
    },
    "examples": [
      {
        "scopeRoot": ".",
        "message": "chore: update generated artifact",
        "files": [
          "src/index.ts"
        ]
      }
    ]
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": true
  },
  "capabilities": [
    "repository.modify"
  ],
  "effects": [
    "repository.change"
  ],
  "risk": "high",
  "invocation": {
    "mode": "unary",
    "idempotency": "supported",
    "cancellable": true,
    "resumable": false
  },
  "resources": {
    "timeoutMs": 120000,
    "maxOutputBytes": 4194304,
    "maxAttempts": 1
  },
  "discovery": {
    "intents": [
      "create commit"
    ],
    "contexts": [
      "general",
      "space",
      "requirement",
      "workflow",
      "schedule"
    ]
  }
}
