{
  "schemaVersion": 1,
  "id": "builtin.git.file_history",
  "version": "1.0.2",
  "name": "File history",
  "description": "Read bounded history for one file.",
  "tags": [
    "git"
  ],
  "executor": {
    "kind": "builtin",
    "handler": "git.file_history",
    "handlerVersion": "1.0.0"
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "path"
    ],
    "properties": {
      "scopeRoot": {
        "type": "string",
        "minLength": 1,
        "description": "Optional authorized root override. Omit or pass \".\" to use the current authorized root.",
        "examples": [
          "."
        ]
      },
      "path": {
        "type": "string",
        "minLength": 1,
        "description": "Authorized local path as a relative path under the authorized root. Do not invent or pass absolute local paths.",
        "examples": [
          "docs/example.md"
        ]
      },
      "maxCount": {
        "type": "integer",
        "minimum": 1,
        "maximum": 500,
        "description": "Maximum number of history entries returned.",
        "examples": [
          20
        ]
      }
    },
    "examples": [
      {
        "scopeRoot": ".",
        "path": "docs/example.md",
        "maxCount": 20
      }
    ]
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": true
  },
  "capabilities": [
    "repository.read"
  ],
  "effects": [
    "local_data.read"
  ],
  "risk": "low",
  "invocation": {
    "mode": "unary",
    "idempotency": "supported",
    "cancellable": true,
    "resumable": false
  },
  "resources": {
    "timeoutMs": 120000,
    "maxOutputBytes": 4194304,
    "maxAttempts": 1
  },
  "discovery": {
    "intents": [
      "file history"
    ],
    "contexts": [
      "general",
      "space",
      "requirement",
      "workflow",
      "schedule"
    ]
  }
}
