{
  "schemaVersion": 1,
  "id": "builtin.process.discover",
  "version": "1.0.4",
  "name": "Discover tools",
  "description": "Discover local executables and versions.",
  "tags": [
    "process"
  ],
  "executor": {
    "kind": "builtin",
    "handler": "process.discover",
    "handlerVersion": "1.0.0"
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "names"
    ],
    "properties": {
      "names": {
        "type": "array",
        "minItems": 1,
        "maxItems": 100,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,199}$",
          "examples": [
            "python3"
          ]
        },
        "description": "Executable names to discover on the local machine.",
        "examples": [
          [
            "python3"
          ]
        ]
      },
      "cwd": {
        "type": "string",
        "description": "Working directory as a relative path under the authorized root. Do not invent or pass absolute local paths.",
        "examples": [
          "."
        ]
      },
      "scopeRoot": {
        "type": "string",
        "minLength": 1,
        "description": "Optional authorized root override. Omit or pass \".\" to use the current authorized root.",
        "examples": [
          "."
        ]
      }
    },
    "examples": [
      {
        "names": [
          "python3"
        ],
        "cwd": ".",
        "scopeRoot": "."
      }
    ]
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": true
  },
  "capabilities": [
    "process.discover"
  ],
  "effects": [
    "local_process.change"
  ],
  "risk": "low",
  "invocation": {
    "mode": "unary",
    "idempotency": "supported",
    "cancellable": true,
    "resumable": false
  },
  "resources": {
    "timeoutMs": 120000,
    "maxOutputBytes": 4194304,
    "maxAttempts": 1
  },
  "discovery": {
    "intents": [
      "discover tools"
    ],
    "contexts": [
      "general",
      "space",
      "requirement",
      "workflow",
      "schedule"
    ]
  }
}
