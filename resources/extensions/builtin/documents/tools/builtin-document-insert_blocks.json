{
  "schemaVersion": 1,
  "id": "builtin.document.insert_blocks",
  "version": "1.1.0",
  "name": "Insert document blocks",
  "description": "Insert Markdown as structured document blocks.",
  "tags": [
    "document"
  ],
  "executor": {
    "kind": "builtin",
    "handler": "document.insert_blocks",
    "handlerVersion": "1.0.0"
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "sessionId": {
        "type": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f-]{27,}$",
        "description": "Stable local editing or browser session ID returned by an inspect/create tool.",
        "examples": [
          "12345678-1234-4234-9234-123456789abc"
        ]
      },
      "expectedRevision": {
        "type": "integer",
        "minimum": 0,
        "description": "Expected revision used for optimistic concurrency control. Copy this value from the latest RealmFlow UI/API state; do not invent it.",
        "examples": [
          1
        ]
      },
      "afterBlockId": {
        "type": "string",
        "pattern": "^(paragraph|table)-[1-9][0-9]*$",
        "description": "Stable block ID after which new document content is inserted.",
        "examples": [
          "paragraph-1"
        ]
      },
      "markdown": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000000,
        "description": "Markdown content inserted as structured document blocks after the target block.",
        "examples": [
          "example"
        ]
      }
    },
    "required": [
      "sessionId",
      "expectedRevision",
      "afterBlockId",
      "markdown"
    ],
    "examples": [
      {
        "sessionId": "12345678-1234-4234-9234-123456789abc",
        "expectedRevision": 1,
        "afterBlockId": "paragraph-1",
        "markdown": "example"
      }
    ]
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": true
  },
  "capabilities": [
    "filesystem.write"
  ],
  "effects": [
    "local_data.change"
  ],
  "risk": "medium",
  "invocation": {
    "mode": "unary",
    "idempotency": "supported",
    "cancellable": true,
    "resumable": false
  },
  "resources": {
    "timeoutMs": 120000,
    "maxOutputBytes": 4194304,
    "maxAttempts": 1
  },
  "discovery": {
    "intents": [
      "insert document blocks"
    ],
    "contexts": [
      "general",
      "space",
      "requirement",
      "workflow",
      "schedule"
    ]
  }
}
