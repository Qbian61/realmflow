{
  "schemaVersion": 1,
  "id": "builtin.document.table_insert",
  "version": "1.1.0",
  "name": "Insert document table",
  "description": "Insert a structured table after a document block.",
  "tags": [
    "document"
  ],
  "executor": {
    "kind": "builtin",
    "handler": "document.table_insert",
    "handlerVersion": "1.0.0"
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "sessionId": {
        "type": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f-]{27,}$",
        "description": "Stable local editing or browser session ID returned by an inspect/create tool.",
        "examples": [
          "12345678-1234-4234-9234-123456789abc"
        ]
      },
      "expectedRevision": {
        "type": "integer",
        "minimum": 0,
        "description": "Expected revision used for optimistic concurrency control. Copy this value from the latest RealmFlow UI/API state; do not invent it.",
        "examples": [
          1
        ]
      },
      "afterBlockId": {
        "type": "string",
        "pattern": "^(paragraph|table)-[1-9][0-9]*$",
        "description": "Stable block ID after which new document content is inserted.",
        "examples": [
          "paragraph-1"
        ]
      },
      "rows": {
        "type": "array",
        "minItems": 1,
        "maxItems": 1000,
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "string",
            "maxLength": 100000,
            "examples": [
              [
                [
                  "Name",
                  "Value"
                ]
              ]
            ]
          },
          "examples": [
            [
              [
                "Name",
                "Value"
              ]
            ]
          ]
        },
        "description": "Two-dimensional table rows written into a document, slide, or sheet.",
        "examples": [
          [
            [
              "Name",
              "Value"
            ]
          ]
        ]
      }
    },
    "required": [
      "sessionId",
      "expectedRevision",
      "afterBlockId",
      "rows"
    ],
    "examples": [
      {
        "sessionId": "12345678-1234-4234-9234-123456789abc",
        "expectedRevision": 1,
        "afterBlockId": "paragraph-1",
        "rows": [
          [
            "Name",
            "Value"
          ]
        ]
      }
    ]
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": true
  },
  "capabilities": [
    "filesystem.write"
  ],
  "effects": [
    "local_data.change"
  ],
  "risk": "medium",
  "invocation": {
    "mode": "unary",
    "idempotency": "supported",
    "cancellable": true,
    "resumable": false
  },
  "resources": {
    "timeoutMs": 120000,
    "maxOutputBytes": 4194304,
    "maxAttempts": 1
  },
  "discovery": {
    "intents": [
      "insert document table"
    ],
    "contexts": [
      "general",
      "space",
      "requirement",
      "workflow",
      "schedule"
    ]
  }
}
