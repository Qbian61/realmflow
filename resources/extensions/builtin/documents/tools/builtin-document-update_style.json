{
  "schemaVersion": 1,
  "id": "builtin.document.update_style",
  "version": "1.1.1",
  "name": "Update document style",
  "description": "Update a paragraph style using its stable block ID.",
  "tags": [
    "document"
  ],
  "executor": {
    "kind": "builtin",
    "handler": "document.update_style",
    "handlerVersion": "1.0.0"
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "sessionId": {
        "type": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f-]{27,}$",
        "description": "Stable local editing or browser session ID returned by an inspect/create tool.",
        "examples": [
          "12345678-1234-4234-9234-123456789abc"
        ]
      },
      "expectedRevision": {
        "type": "integer",
        "minimum": 0,
        "description": "Expected revision used for optimistic concurrency control. Copy this value from the latest RealmFlow UI/API state; do not invent it.",
        "examples": [
          1
        ]
      },
      "blockId": {
        "type": "string",
        "pattern": "^paragraph-[1-9][0-9]*$",
        "description": "Stable document block ID to update or comment on.",
        "examples": [
          "paragraph-1"
        ]
      },
      "style": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "styleName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "Named document style to apply to the selected text block.",
            "examples": [
              "example"
            ]
          },
          "bold": {
            "type": "boolean",
            "description": "Whether the selected document text should use bold styling.",
            "examples": [
              true
            ]
          },
          "italic": {
            "type": "boolean",
            "description": "Whether the selected document text should use italic styling.",
            "examples": [
              true
            ]
          },
          "fontSizePt": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 512,
            "description": "Document font size in points for the selected text style.",
            "examples": [
              1
            ]
          }
        },
        "description": "Structured style patch for the target document or spreadsheet range.",
        "examples": [
          {
            "bold": true
          }
        ]
      }
    },
    "required": [
      "sessionId",
      "expectedRevision",
      "blockId",
      "style"
    ],
    "examples": [
      {
        "sessionId": "12345678-1234-4234-9234-123456789abc",
        "expectedRevision": 1,
        "blockId": "paragraph-1",
        "style": {
          "bold": true
        }
      }
    ]
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": true
  },
  "capabilities": [
    "filesystem.write"
  ],
  "effects": [
    "local_data.change"
  ],
  "risk": "medium",
  "invocation": {
    "mode": "unary",
    "idempotency": "supported",
    "cancellable": true,
    "resumable": false
  },
  "resources": {
    "timeoutMs": 120000,
    "maxOutputBytes": 4194304,
    "maxAttempts": 1
  },
  "discovery": {
    "intents": [
      "update document style"
    ],
    "contexts": [
      "general",
      "space",
      "requirement",
      "workflow",
      "schedule"
    ]
  }
}
