{
  "schemaVersion": 1,
  "id": "builtin.document.create",
  "version": "1.1.0",
  "name": "Create document",
  "description": "Create a deterministic DOCX from structured content at an authorized new path.",
  "tags": [
    "document"
  ],
  "executor": {
    "kind": "builtin",
    "handler": "document.create",
    "handlerVersion": "1.0.0"
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "outputPath",
      "expectedAbsent",
      "document"
    ],
    "properties": {
      "outputPath": {
        "type": "string",
        "minLength": 1
      },
      "expectedAbsent": {
        "type": "boolean",
        "const": true
      },
      "scopeRoot": {
        "type": "string",
        "minLength": 1
      },
      "document": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "blocks"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "blocks": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10000,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "level",
                    "text"
                  ],
                  "properties": {
                    "kind": {
                      "const": "heading"
                    },
                    "level": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100000
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "text"
                  ],
                  "properties": {
                    "kind": {
                      "const": "paragraph"
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100000
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "items"
                  ],
                  "properties": {
                    "kind": {
                      "const": "bullet_list"
                    },
                    "items": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 10000,
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 100000
                      }
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "rows"
                  ],
                  "properties": {
                    "kind": {
                      "const": "table"
                    },
                    "rows": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 1000,
                      "items": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 100,
                        "items": {
                          "type": "string",
                          "maxLength": 100000
                        }
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": true
  },
  "capabilities": [
    "filesystem.write"
  ],
  "effects": [
    "local_data.change"
  ],
  "risk": "medium",
  "invocation": {
    "mode": "unary",
    "idempotency": "supported",
    "cancellable": true,
    "resumable": false
  },
  "resources": {
    "timeoutMs": 120000,
    "maxOutputBytes": 4194304,
    "maxAttempts": 1
  },
  "discovery": {
    "intents": [
      "create document"
    ],
    "contexts": [
      "general",
      "space",
      "requirement",
      "workflow",
      "schedule"
    ]
  }
}
