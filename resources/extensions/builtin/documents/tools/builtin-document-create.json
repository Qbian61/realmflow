{
  "schemaVersion": 1,
  "id": "builtin.document.create",
  "version": "1.1.0",
  "name": "Create document",
  "description": "Create a deterministic DOCX from structured content at an authorized new path.",
  "tags": [
    "document"
  ],
  "executor": {
    "kind": "builtin",
    "handler": "document.create",
    "handlerVersion": "1.0.0"
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "outputPath",
      "expectedAbsent",
      "document"
    ],
    "properties": {
      "outputPath": {
        "type": "string",
        "minLength": 1,
        "description": "Authorized new output path as a relative path under the authorized root; it must not overwrite existing content. Do not invent or pass absolute local paths.",
        "examples": [
          "exports/result.pdf"
        ]
      },
      "expectedAbsent": {
        "type": "boolean",
        "const": true,
        "description": "Must be true to confirm the target path does not already exist.",
        "examples": [
          true
        ]
      },
      "scopeRoot": {
        "type": "string",
        "minLength": 1,
        "description": "Optional authorized root override. Omit or pass \".\" to use the current authorized root.",
        "examples": [
          "."
        ]
      },
      "document": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "blocks"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "description": "User-visible title.",
            "examples": [
              "Quarterly update"
            ]
          },
          "blocks": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10000,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "level",
                    "text"
                  ],
                  "properties": {
                    "kind": {
                      "const": "heading",
                      "description": "Discriminator selecting the schema variant for this object.",
                      "examples": [
                        "heading"
                      ]
                    },
                    "level": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9,
                      "description": "Heading level for a structured document heading block.",
                      "examples": [
                        1
                      ]
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100000,
                      "description": "Text content used by the requested operation.",
                      "examples": [
                        "Example text."
                      ]
                    }
                  },
                  "examples": [
                    {
                      "kind": "heading",
                      "level": 1,
                      "text": "Example text."
                    }
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "text"
                  ],
                  "properties": {
                    "kind": {
                      "const": "paragraph",
                      "description": "Discriminator selecting the schema variant for this object.",
                      "examples": [
                        "paragraph"
                      ]
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100000,
                      "description": "Text content used by the requested operation.",
                      "examples": [
                        "Example text."
                      ]
                    }
                  },
                  "examples": [
                    {
                      "kind": "paragraph",
                      "text": "Example text."
                    }
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "items"
                  ],
                  "properties": {
                    "kind": {
                      "const": "bullet_list",
                      "description": "Discriminator selecting the schema variant for this object.",
                      "examples": [
                        "bullet_list"
                      ]
                    },
                    "items": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 10000,
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 100000,
                        "examples": [
                          "example"
                        ]
                      },
                      "description": "Ordered list item text values for a bullet list block.",
                      "examples": [
                        [
                          "example"
                        ]
                      ]
                    }
                  },
                  "examples": [
                    {
                      "kind": "bullet_list",
                      "items": [
                        "example"
                      ]
                    }
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "rows"
                  ],
                  "properties": {
                    "kind": {
                      "const": "table",
                      "description": "Discriminator selecting the schema variant for this object.",
                      "examples": [
                        "table"
                      ]
                    },
                    "rows": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 1000,
                      "items": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 100,
                        "items": {
                          "type": "string",
                          "maxLength": 100000,
                          "examples": [
                            [
                              [
                                "Name",
                                "Value"
                              ]
                            ]
                          ]
                        },
                        "examples": [
                          [
                            [
                              "Name",
                              "Value"
                            ]
                          ]
                        ]
                      },
                      "description": "Two-dimensional table rows written into a document, slide, or sheet.",
                      "examples": [
                        [
                          [
                            "Name",
                            "Value"
                          ]
                        ]
                      ]
                    }
                  },
                  "examples": [
                    {
                      "kind": "table",
                      "rows": [
                        [
                          "Name",
                          "Value"
                        ]
                      ]
                    }
                  ]
                }
              ],
              "examples": [
                {
                  "kind": "heading",
                  "level": 1,
                  "text": "Example text."
                }
              ]
            },
            "description": "Ordered structured document blocks used to build or inspect the document.",
            "examples": [
              [
                {
                  "kind": "heading",
                  "level": 1,
                  "text": "Example text."
                }
              ]
            ]
          }
        },
        "description": "Structured document payload used to create a DOCX, including the title and ordered content blocks.",
        "examples": [
          {
            "title": "Project brief",
            "blocks": [
              {
                "kind": "paragraph",
                "text": "Summary"
              }
            ]
          }
        ]
      }
    },
    "examples": [
      {
        "outputPath": "exports/result.pdf",
        "expectedAbsent": true,
        "scopeRoot": ".",
        "document": {
          "title": "Project brief",
          "blocks": [
            {
              "kind": "paragraph",
              "text": "Summary"
            }
          ]
        }
      }
    ]
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": true
  },
  "capabilities": [
    "filesystem.write"
  ],
  "effects": [
    "local_data.change"
  ],
  "risk": "medium",
  "invocation": {
    "mode": "unary",
    "idempotency": "supported",
    "cancellable": true,
    "resumable": false
  },
  "resources": {
    "timeoutMs": 120000,
    "maxOutputBytes": 4194304,
    "maxAttempts": 1
  },
  "discovery": {
    "intents": [
      "create document"
    ],
    "contexts": [
      "general",
      "space",
      "requirement",
      "workflow",
      "schedule"
    ]
  }
}
