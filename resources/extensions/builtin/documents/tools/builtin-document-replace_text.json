{
  "schemaVersion": 1,
  "id": "builtin.document.replace_text",
  "version": "1.1.0",
  "name": "Replace document text",
  "description": "Replace text without rewriting unrelated blocks.",
  "tags": [
    "document"
  ],
  "executor": {
    "kind": "builtin",
    "handler": "document.replace_text",
    "handlerVersion": "1.0.0"
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "sessionId": {
        "type": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f-]{27,}$",
        "description": "Stable local editing or browser session ID returned by an inspect/create tool.",
        "examples": [
          "12345678-1234-4234-9234-123456789abc"
        ]
      },
      "expectedRevision": {
        "type": "integer",
        "minimum": 0,
        "description": "Expected revision used for optimistic concurrency control. Copy this value from the latest RealmFlow UI/API state; do not invent it.",
        "examples": [
          1
        ]
      },
      "query": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100000,
        "description": "Search or match query supplied by the user or current task.",
        "examples": [
          "release notes"
        ]
      },
      "replacement": {
        "type": "string",
        "maxLength": 100000,
        "description": "Replacement text written for each matched document occurrence.",
        "examples": [
          "updated text"
        ]
      },
      "replaceAll": {
        "type": "boolean",
        "description": "Whether every match should be replaced instead of only the first match.",
        "examples": [
          true
        ]
      }
    },
    "required": [
      "sessionId",
      "expectedRevision",
      "query",
      "replacement"
    ],
    "examples": [
      {
        "sessionId": "12345678-1234-4234-9234-123456789abc",
        "expectedRevision": 1,
        "query": "release notes",
        "replacement": "updated text",
        "replaceAll": true
      }
    ]
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": true
  },
  "capabilities": [
    "filesystem.write"
  ],
  "effects": [
    "local_data.change"
  ],
  "risk": "medium",
  "invocation": {
    "mode": "unary",
    "idempotency": "supported",
    "cancellable": true,
    "resumable": false
  },
  "resources": {
    "timeoutMs": 120000,
    "maxOutputBytes": 4194304,
    "maxAttempts": 1
  },
  "discovery": {
    "intents": [
      "replace document text"
    ],
    "contexts": [
      "general",
      "space",
      "requirement",
      "workflow",
      "schedule"
    ]
  }
}
