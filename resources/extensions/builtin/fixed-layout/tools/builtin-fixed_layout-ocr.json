{
  "schemaVersion": 1,
  "id": "builtin.fixed_layout.ocr",
  "version": "1.1.0",
  "name": "Recognize OFD page",
  "description": "Render and recognize one scanned OFD page with the bundled local OCR runtime.",
  "tags": [
    "fixed_layout"
  ],
  "executor": {
    "kind": "builtin",
    "handler": "fixed_layout.ocr",
    "handlerVersion": "1.0.0"
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "path",
      "pageNumber"
    ],
    "properties": {
      "path": {
        "type": "string",
        "minLength": 1,
        "description": "Authorized local path as a relative path under the authorized root. Do not invent or pass absolute local paths.",
        "examples": [
          "docs/example.md"
        ]
      },
      "scopeRoot": {
        "type": "string",
        "minLength": 1,
        "description": "Optional authorized root override. Omit or pass \".\" to use the current authorized root.",
        "examples": [
          "."
        ]
      },
      "pageNumber": {
        "type": "integer",
        "minimum": 1,
        "maximum": 2000,
        "description": "One-based page number.",
        "examples": [
          1
        ]
      },
      "language": {
        "type": "string",
        "enum": [
          "eng",
          "chi_sim"
        ],
        "description": "Language or locale code used by OCR, search, or content processing. Allowed values: eng, chi_sim.",
        "examples": [
          "eng"
        ]
      },
      "maxDimension": {
        "type": "integer",
        "minimum": 64,
        "maximum": 2400,
        "description": "Maximum rendered image dimension in pixels.",
        "examples": [
          1024
        ]
      }
    },
    "examples": [
      {
        "path": "docs/example.md",
        "scopeRoot": ".",
        "pageNumber": 1,
        "language": "eng",
        "maxDimension": 1024
      }
    ]
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": true
  },
  "capabilities": [
    "filesystem.read"
  ],
  "effects": [
    "local_data.read"
  ],
  "risk": "low",
  "invocation": {
    "mode": "unary",
    "idempotency": "supported",
    "cancellable": true,
    "resumable": false
  },
  "resources": {
    "timeoutMs": 120000,
    "maxOutputBytes": 4194304,
    "maxAttempts": 1
  },
  "discovery": {
    "intents": [
      "recognize ofd page"
    ],
    "contexts": [
      "general",
      "space",
      "requirement",
      "workflow",
      "schedule"
    ]
  }
}
