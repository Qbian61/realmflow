{
  "schemaVersion": 1,
  "id": "builtin.image.rotate",
  "version": "1.0.0",
  "name": "Rotate image",
  "description": "Rotate an image after applying its stored orientation.",
  "tags": [
    "image"
  ],
  "executor": {
    "kind": "builtin",
    "handler": "image.rotate",
    "handlerVersion": "1.0.0"
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "sessionId": {
        "type": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f-]{27,}$"
      },
      "expectedRevision": {
        "type": "integer",
        "minimum": 0
      },
      "angle": {
        "type": "number",
        "minimum": -360,
        "maximum": 360
      }
    },
    "required": [
      "sessionId",
      "expectedRevision",
      "angle"
    ]
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": true
  },
  "capabilities": [
    "filesystem.write"
  ],
  "effects": [
    "local_data.change"
  ],
  "risk": "medium",
  "invocation": {
    "mode": "unary",
    "idempotency": "supported",
    "cancellable": true,
    "resumable": false
  },
  "resources": {
    "timeoutMs": 120000,
    "maxOutputBytes": 4194304,
    "maxAttempts": 1
  },
  "discovery": {
    "intents": [
      "rotate image"
    ],
    "contexts": [
      "general",
      "space",
      "requirement",
      "workflow",
      "schedule"
    ]
  }
}
