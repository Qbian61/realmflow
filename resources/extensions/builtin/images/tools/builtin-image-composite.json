{
  "schemaVersion": 1,
  "id": "builtin.image.composite",
  "version": "1.0.0",
  "name": "Composite image",
  "description": "Composite bounded local image layers.",
  "tags": [
    "image"
  ],
  "executor": {
    "kind": "builtin",
    "handler": "image.composite",
    "handlerVersion": "1.0.0"
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "sessionId": {
        "type": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f-]{27,}$",
        "description": "Stable local editing or browser session ID returned by an inspect/create tool.",
        "examples": [
          "12345678-1234-4234-9234-123456789abc"
        ]
      },
      "expectedRevision": {
        "type": "integer",
        "minimum": 0,
        "description": "Expected revision used for optimistic concurrency control. Copy this value from the latest RealmFlow UI/API state; do not invent it.",
        "examples": [
          1
        ]
      },
      "overlays": {
        "type": "array",
        "minItems": 1,
        "maxItems": 100,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contentBase64",
            "left",
            "top"
          ],
          "properties": {
            "contentBase64": {
              "type": "string",
              "minLength": 1,
              "description": "Base64-encoded image layer content used by the composite operation.",
              "examples": [
                "example"
              ]
            },
            "left": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20000,
              "description": "Left pixel coordinate of the image rectangle.",
              "examples": [
                0
              ]
            },
            "top": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20000,
              "description": "Top pixel coordinate of the image rectangle.",
              "examples": [
                0
              ]
            }
          },
          "examples": [
            [
              {
                "contentBase64": "aGVsbG8=",
                "left": 0,
                "top": 0
              }
            ]
          ]
        },
        "description": "Image overlay layers to composite in order.",
        "examples": [
          [
            {
              "contentBase64": "aGVsbG8=",
              "left": 0,
              "top": 0
            }
          ]
        ]
      }
    },
    "required": [
      "sessionId",
      "expectedRevision",
      "overlays"
    ],
    "examples": [
      {
        "sessionId": "12345678-1234-4234-9234-123456789abc",
        "expectedRevision": 1,
        "overlays": [
          {
            "contentBase64": "aGVsbG8=",
            "left": 0,
            "top": 0
          }
        ]
      }
    ]
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": true
  },
  "capabilities": [
    "filesystem.write"
  ],
  "effects": [
    "local_data.change"
  ],
  "risk": "medium",
  "invocation": {
    "mode": "unary",
    "idempotency": "supported",
    "cancellable": true,
    "resumable": false
  },
  "resources": {
    "timeoutMs": 120000,
    "maxOutputBytes": 4194304,
    "maxAttempts": 1
  },
  "discovery": {
    "intents": [
      "composite image"
    ],
    "contexts": [
      "general",
      "space",
      "requirement",
      "workflow",
      "schedule"
    ]
  }
}
