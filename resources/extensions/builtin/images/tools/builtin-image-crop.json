{
  "schemaVersion": 1,
  "id": "builtin.image.crop",
  "version": "1.0.1",
  "name": "Crop image",
  "description": "Crop an explicit image rectangle.",
  "tags": [
    "image"
  ],
  "executor": {
    "kind": "builtin",
    "handler": "image.crop",
    "handlerVersion": "1.0.0"
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "sessionId": {
        "type": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f-]{27,}$",
        "description": "Stable local editing or browser session ID returned by an inspect/create tool.",
        "examples": [
          "12345678-1234-4234-9234-123456789abc"
        ]
      },
      "expectedRevision": {
        "type": "integer",
        "minimum": 0,
        "description": "Expected revision used for optimistic concurrency control. Copy this value from the latest RealmFlow UI/API state; do not invent it.",
        "examples": [
          1
        ]
      },
      "left": {
        "type": "integer",
        "minimum": 0,
        "maximum": 20000,
        "description": "Left pixel coordinate of the image rectangle.",
        "examples": [
          0
        ]
      },
      "top": {
        "type": "integer",
        "minimum": 0,
        "maximum": 20000,
        "description": "Top pixel coordinate of the image rectangle.",
        "examples": [
          0
        ]
      },
      "width": {
        "type": "integer",
        "minimum": 1,
        "maximum": 20000,
        "description": "Width in pixels for the image operation.",
        "examples": [
          320
        ]
      },
      "height": {
        "type": "integer",
        "minimum": 1,
        "maximum": 20000,
        "description": "Height in pixels for the image operation.",
        "examples": [
          240
        ]
      }
    },
    "required": [
      "sessionId",
      "expectedRevision",
      "left",
      "top",
      "width",
      "height"
    ],
    "examples": [
      {
        "sessionId": "12345678-1234-4234-9234-123456789abc",
        "expectedRevision": 1,
        "left": 0,
        "top": 0,
        "width": 320,
        "height": 240
      }
    ]
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": true
  },
  "capabilities": [
    "filesystem.write"
  ],
  "effects": [
    "local_data.change"
  ],
  "risk": "medium",
  "invocation": {
    "mode": "unary",
    "idempotency": "supported",
    "cancellable": true,
    "resumable": false
  },
  "resources": {
    "timeoutMs": 120000,
    "maxOutputBytes": 4194304,
    "maxAttempts": 1
  },
  "discovery": {
    "intents": [
      "crop image"
    ],
    "contexts": [
      "general",
      "space",
      "requirement",
      "workflow",
      "schedule"
    ]
  }
}
