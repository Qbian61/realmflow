{
  "schemaVersion": 1,
  "id": "builtin.image.redact",
  "version": "1.0.1",
  "name": "Redact image",
  "description": "Cover explicit image regions with an opaque color.",
  "tags": [
    "image"
  ],
  "executor": {
    "kind": "builtin",
    "handler": "image.redact",
    "handlerVersion": "1.0.0"
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "sessionId": {
        "type": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f-]{27,}$",
        "description": "Stable local editing or browser session ID returned by an inspect/create tool.",
        "examples": [
          "12345678-1234-4234-9234-123456789abc"
        ]
      },
      "expectedRevision": {
        "type": "integer",
        "minimum": 0,
        "description": "Expected revision used for optimistic concurrency control. Copy this value from the latest RealmFlow UI/API state; do not invent it.",
        "examples": [
          1
        ]
      },
      "regions": {
        "type": "array",
        "minItems": 1,
        "maxItems": 100,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "left",
            "top",
            "width",
            "height"
          ],
          "properties": {
            "left": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20000,
              "description": "Left pixel coordinate of the image rectangle.",
              "examples": [
                0
              ]
            },
            "top": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20000,
              "description": "Top pixel coordinate of the image rectangle.",
              "examples": [
                0
              ]
            },
            "width": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20000,
              "description": "Width in pixels for the image operation.",
              "examples": [
                320
              ]
            },
            "height": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20000,
              "description": "Height in pixels for the image operation.",
              "examples": [
                240
              ]
            }
          },
          "examples": [
            [
              {
                "left": 0,
                "top": 0,
                "width": 80,
                "height": 40
              }
            ]
          ]
        },
        "description": "Image rectangles to redact, each with pixel coordinates and dimensions.",
        "examples": [
          [
            {
              "left": 0,
              "top": 0,
              "width": 80,
              "height": 40
            }
          ]
        ]
      },
      "color": {
        "type": "string",
        "pattern": "^#[0-9a-fA-F]{6}$",
        "description": "Hex RGB fill color used for image redaction.",
        "examples": [
          "#ff0000"
        ]
      }
    },
    "required": [
      "sessionId",
      "expectedRevision",
      "regions"
    ],
    "examples": [
      {
        "sessionId": "12345678-1234-4234-9234-123456789abc",
        "expectedRevision": 1,
        "regions": [
          {
            "left": 0,
            "top": 0,
            "width": 80,
            "height": 40
          }
        ],
        "color": "#ff0000"
      }
    ]
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": true
  },
  "capabilities": [
    "filesystem.write"
  ],
  "effects": [
    "local_data.change"
  ],
  "risk": "high",
  "invocation": {
    "mode": "unary",
    "idempotency": "supported",
    "cancellable": true,
    "resumable": false
  },
  "resources": {
    "timeoutMs": 120000,
    "maxOutputBytes": 4194304,
    "maxAttempts": 1
  },
  "discovery": {
    "intents": [
      "redact image"
    ],
    "contexts": [
      "general",
      "space",
      "requirement",
      "workflow",
      "schedule"
    ]
  }
}
