{
  "schemaVersion": 1,
  "id": "builtin.browser.download",
  "version": "1.0.0",
  "name": "Download browser file",
  "description": "Download up to 32 MiB with the current Run browser into authorized roots without overwrite. Redirects are rejected. Also writes a .realmflow-browser.json provenance sidecar.",
  "tags": [
    "browser"
  ],
  "executor": {
    "kind": "builtin",
    "handler": "browser.download",
    "handlerVersion": "1.0.0"
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "target": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "const": "current_run"
          }
        }
      },
      "url": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096,
        "pattern": "^https?://"
      },
      "path": {
        "type": "string",
        "minLength": 1,
        "maxLength": 16000
      },
      "expectedAbsent": {
        "type": "boolean",
        "const": true
      }
    },
    "required": [
      "target",
      "url",
      "path",
      "expectedAbsent"
    ]
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": true
  },
  "capabilities": [
    "computer.observe",
    "network.connect",
    "filesystem.write"
  ],
  "effects": [
    "local_data.read",
    "external.read",
    "local_data.change"
  ],
  "risk": "medium",
  "invocation": {
    "mode": "unary",
    "idempotency": "required",
    "cancellable": true,
    "resumable": false
  },
  "resources": {
    "timeoutMs": 120000,
    "maxOutputBytes": 4194304,
    "maxAttempts": 1
  },
  "discovery": {
    "intents": [
      "download browser file"
    ],
    "contexts": [
      "general",
      "space",
      "requirement",
      "workflow",
      "schedule"
    ]
  }
}
