{
  "schemaVersion": 1,
  "id": "builtin.browser.upload",
  "version": "1.0.0",
  "name": "Upload browser file",
  "description": "Upload a regular file up to 32 MiB from authorized roots using a current file-input ref in the current Run browser.",
  "tags": [
    "browser"
  ],
  "executor": {
    "kind": "builtin",
    "handler": "browser.upload",
    "handlerVersion": "1.0.0"
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "target": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "const": "current_run",
            "description": "Discriminator selecting the schema variant for this object.",
            "examples": [
              "current_run"
            ]
          }
        },
        "description": "Current run target object for browser or UI automation.",
        "examples": [
          {
            "kind": "current_run"
          }
        ]
      },
      "ref": {
        "type": "string",
        "minLength": 1,
        "maxLength": 16000,
        "description": "Current browser snapshot reference for the target element.",
        "examples": [
          "ref-1"
        ]
      },
      "path": {
        "type": "string",
        "minLength": 1,
        "maxLength": 16000,
        "description": "Authorized local path as a relative path under the authorized root. Do not invent or pass absolute local paths.",
        "examples": [
          "docs/example.md"
        ]
      }
    },
    "required": [
      "target",
      "ref",
      "path"
    ],
    "examples": [
      {
        "target": {
          "kind": "current_run"
        },
        "ref": "ref-1",
        "path": "docs/example.md"
      }
    ]
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": true
  },
  "capabilities": [
    "computer.control",
    "network.connect",
    "filesystem.read"
  ],
  "effects": [
    "user_interface.change",
    "external.read",
    "local_data.read"
  ],
  "risk": "medium",
  "invocation": {
    "mode": "unary",
    "idempotency": "required",
    "cancellable": true,
    "resumable": false
  },
  "resources": {
    "timeoutMs": 120000,
    "maxOutputBytes": 4194304,
    "maxAttempts": 1
  },
  "discovery": {
    "intents": [
      "upload browser file"
    ],
    "contexts": [
      "general",
      "space",
      "requirement",
      "workflow",
      "schedule"
    ]
  }
}
