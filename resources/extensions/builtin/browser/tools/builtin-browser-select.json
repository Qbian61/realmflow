{
  "schemaVersion": 1,
  "id": "builtin.browser.select",
  "version": "1.0.1",
  "name": "Select browser option",
  "description": "Select an option by value in the current Run browser using a current snapshot ref.",
  "tags": [
    "browser"
  ],
  "executor": {
    "kind": "builtin",
    "handler": "browser.select",
    "handlerVersion": "1.0.0"
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "target": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "const": "current_run",
            "description": "Discriminator selecting the schema variant for this object.",
            "examples": [
              "current_run"
            ]
          }
        },
        "description": "Current run target object for browser or UI automation.",
        "examples": [
          {
            "kind": "current_run"
          }
        ]
      },
      "ref": {
        "type": "string",
        "minLength": 1,
        "maxLength": 16000,
        "description": "Current browser snapshot reference for the target element.",
        "examples": [
          "ref-1"
        ]
      },
      "value": {
        "type": "string",
        "minLength": 0,
        "maxLength": 16000,
        "description": "Value used by the form, filter, or selection operation.",
        "examples": [
          "Example value"
        ]
      }
    },
    "required": [
      "target",
      "ref",
      "value"
    ],
    "examples": [
      {
        "target": {
          "kind": "current_run"
        },
        "ref": "ref-1",
        "value": "Example value"
      }
    ]
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": true
  },
  "capabilities": [
    "computer.control",
    "network.connect"
  ],
  "effects": [
    "user_interface.change",
    "external.read"
  ],
  "risk": "medium",
  "invocation": {
    "mode": "unary",
    "idempotency": "required",
    "cancellable": true,
    "resumable": false
  },
  "resources": {
    "timeoutMs": 120000,
    "maxOutputBytes": 4194304,
    "maxAttempts": 1
  },
  "discovery": {
    "intents": [
      "select browser option"
    ],
    "contexts": [
      "general",
      "space",
      "requirement",
      "workflow",
      "schedule"
    ]
  }
}
