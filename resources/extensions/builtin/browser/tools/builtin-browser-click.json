{
  "schemaVersion": 1,
  "id": "builtin.browser.click",
  "version": "1.0.1",
  "name": "Click browser element",
  "description": "Click a visible unobstructed element in the current Run browser using a current snapshot ref. May submit data.",
  "tags": [
    "browser"
  ],
  "executor": {
    "kind": "builtin",
    "handler": "browser.click",
    "handlerVersion": "1.0.0"
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "target": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "const": "current_run",
            "description": "Discriminator selecting the schema variant for this object.",
            "examples": [
              "current_run"
            ]
          }
        },
        "description": "Current run target object for browser or UI automation.",
        "examples": [
          {
            "kind": "current_run"
          }
        ]
      },
      "ref": {
        "type": "string",
        "minLength": 1,
        "maxLength": 16000,
        "description": "Current browser snapshot reference for the target element.",
        "examples": [
          "ref-1"
        ]
      }
    },
    "required": [
      "target",
      "ref"
    ],
    "examples": [
      {
        "target": {
          "kind": "current_run"
        },
        "ref": "ref-1"
      }
    ]
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": true
  },
  "capabilities": [
    "computer.control",
    "network.connect"
  ],
  "effects": [
    "user_interface.change",
    "external.read"
  ],
  "risk": "medium",
  "invocation": {
    "mode": "unary",
    "idempotency": "required",
    "cancellable": true,
    "resumable": false
  },
  "resources": {
    "timeoutMs": 120000,
    "maxOutputBytes": 4194304,
    "maxAttempts": 1
  },
  "discovery": {
    "intents": [
      "click browser element"
    ],
    "contexts": [
      "general",
      "space",
      "requirement",
      "workflow",
      "schedule"
    ]
  }
}
