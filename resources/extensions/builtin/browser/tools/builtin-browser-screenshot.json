{
  "schemaVersion": 1,
  "id": "builtin.browser.screenshot",
  "version": "1.0.1",
  "name": "Screenshot browser",
  "description": "Save a PNG from the current Run browser in authorized roots without overwrite; mask sensitive fields and embedded frames. Also writes a .realmflow-browser.json provenance sidecar.",
  "tags": [
    "browser"
  ],
  "executor": {
    "kind": "builtin",
    "handler": "browser.screenshot",
    "handlerVersion": "1.0.0"
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "target": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "const": "current_run",
            "description": "Discriminator selecting the schema variant for this object.",
            "examples": [
              "current_run"
            ]
          }
        },
        "description": "Current run target object for browser or UI automation.",
        "examples": [
          {
            "kind": "current_run"
          }
        ]
      },
      "path": {
        "type": "string",
        "minLength": 1,
        "maxLength": 16000,
        "description": "Authorized local path as a relative path under the authorized root. Do not invent or pass absolute local paths.",
        "examples": [
          "docs/example.md"
        ]
      },
      "expectedAbsent": {
        "type": "boolean",
        "const": true,
        "description": "Must be true to confirm the target path does not already exist.",
        "examples": [
          true
        ]
      }
    },
    "required": [
      "target",
      "path",
      "expectedAbsent"
    ],
    "examples": [
      {
        "target": {
          "kind": "current_run"
        },
        "path": "docs/example.md",
        "expectedAbsent": true
      }
    ]
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": true
  },
  "capabilities": [
    "computer.observe",
    "filesystem.write"
  ],
  "effects": [
    "local_data.read",
    "local_data.change"
  ],
  "risk": "medium",
  "invocation": {
    "mode": "unary",
    "idempotency": "required",
    "cancellable": true,
    "resumable": false
  },
  "resources": {
    "timeoutMs": 120000,
    "maxOutputBytes": 4194304,
    "maxAttempts": 1
  },
  "discovery": {
    "intents": [
      "screenshot browser"
    ],
    "contexts": [
      "general",
      "space",
      "requirement",
      "workflow",
      "schedule"
    ]
  }
}
