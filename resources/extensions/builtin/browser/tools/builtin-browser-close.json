{
  "schemaVersion": 1,
  "id": "builtin.browser.close",
  "version": "1.0.0",
  "name": "Close browser",
  "description": "Close the owned browser session; preserve its local profile.",
  "tags": [
    "browser"
  ],
  "executor": {
    "kind": "builtin",
    "handler": "browser.close",
    "handlerVersion": "1.0.0"
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "sessionId": {
        "type": "string",
        "pattern": "^browser-[A-Za-z0-9-]+$",
        "maxLength": 120
      }
    },
    "required": [
      "sessionId"
    ]
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": true
  },
  "capabilities": [
    "computer.control"
  ],
  "effects": [
    "user_interface.change"
  ],
  "risk": "medium",
  "invocation": {
    "mode": "unary",
    "idempotency": "required",
    "cancellable": true,
    "resumable": false
  },
  "resources": {
    "timeoutMs": 120000,
    "maxOutputBytes": 4194304,
    "maxAttempts": 1
  },
  "discovery": {
    "intents": [
      "close browser"
    ],
    "contexts": [
      "general",
      "space",
      "requirement",
      "workflow",
      "schedule"
    ]
  }
}
