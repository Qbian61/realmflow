{
  "schemaVersion": 1,
  "id": "builtin.browser.evaluate",
  "version": "1.0.0",
  "name": "Evaluate browser snapshot",
  "description": "Evaluate an expression over the current Run sanitized snapshot in an isolated offline sandbox after explicit approval. No live page JavaScript, cookies or storage.",
  "tags": [
    "browser"
  ],
  "executor": {
    "kind": "builtin",
    "handler": "browser.evaluate",
    "handlerVersion": "1.0.0"
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "target": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "const": "current_run",
            "description": "Discriminator selecting the schema variant for this object.",
            "examples": [
              "current_run"
            ]
          }
        },
        "description": "Current run target object for browser or UI automation.",
        "examples": [
          {
            "kind": "current_run"
          }
        ]
      },
      "expression": {
        "type": "string",
        "minLength": 1,
        "maxLength": 16000,
        "description": "Expression evaluated against the sanitized browser snapshot, not live page state.",
        "examples": [
          "example"
        ]
      }
    },
    "required": [
      "target",
      "expression"
    ],
    "examples": [
      {
        "target": {
          "kind": "current_run"
        },
        "expression": "example"
      }
    ]
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": true
  },
  "capabilities": [
    "computer.control"
  ],
  "effects": [
    "user_interface.change"
  ],
  "risk": "high",
  "invocation": {
    "mode": "unary",
    "idempotency": "required",
    "cancellable": true,
    "resumable": false
  },
  "resources": {
    "timeoutMs": 120000,
    "maxOutputBytes": 4194304,
    "maxAttempts": 1
  },
  "discovery": {
    "intents": [
      "evaluate browser snapshot"
    ],
    "contexts": [
      "general",
      "space",
      "requirement",
      "workflow",
      "schedule"
    ],
    "requiresExplicitSelection": true
  }
}
