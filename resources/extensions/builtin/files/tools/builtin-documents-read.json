{
  "schemaVersion": 1,
  "id": "builtin.documents.read",
  "version": "1.3.1",
  "name": "Read document",
  "description": "Read structured pages or blocks locally from authorized PDF and DOCX documents.",
  "tags": [
    "documents"
  ],
  "executor": {
    "kind": "builtin",
    "handler": "documents.read",
    "handlerVersion": "1.0.0"
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "path"
    ],
    "properties": {
      "path": {
        "type": "string",
        "minLength": 1
      },
      "scopeRoot": {
        "type": "string",
        "minLength": 1
      },
      "maxCharacters": {
        "type": "integer",
        "minimum": 1000,
        "maximum": 200000
      },
      "chunkId": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}:chunk:[1-9][0-9]*$"
      }
    }
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": true
  },
  "capabilities": [
    "filesystem.read"
  ],
  "effects": [
    "local_data.read"
  ],
  "risk": "low",
  "invocation": {
    "mode": "unary",
    "idempotency": "supported",
    "cancellable": true,
    "resumable": false
  },
  "resources": {
    "timeoutMs": 120000,
    "maxOutputBytes": 4194304,
    "maxAttempts": 1
  },
  "discovery": {
    "intents": [
      "read document"
    ],
    "contexts": [
      "general",
      "space",
      "requirement",
      "workflow",
      "schedule"
    ]
  }
}
