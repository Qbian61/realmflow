{
  "schemaVersion": 1,
  "id": "builtin.files.trash",
  "version": "1.3.2",
  "name": "Move to trash",
  "description": "Move a file or directory to the system trash.",
  "tags": [
    "files"
  ],
  "executor": {
    "kind": "builtin",
    "handler": "files.trash",
    "handlerVersion": "1.0.0"
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "path",
      "expectedChecksum"
    ],
    "properties": {
      "path": {
        "type": "string",
        "minLength": 1,
        "description": "Authorized local path as a relative path under the authorized root. Do not invent or pass absolute local paths.",
        "examples": [
          "docs/example.md"
        ]
      },
      "scopeRoot": {
        "type": "string",
        "minLength": 1,
        "description": "Optional authorized root override. Omit or pass \".\" to use the current authorized root.",
        "examples": [
          "."
        ]
      },
      "expectedChecksum": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$",
        "description": "SHA-256 checksum of the authorized prior file content.",
        "examples": [
          "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        ]
      }
    },
    "examples": [
      {
        "path": "docs/example.md",
        "scopeRoot": ".",
        "expectedChecksum": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
      }
    ]
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": true
  },
  "capabilities": [
    "filesystem.delete"
  ],
  "effects": [
    "local_data.delete"
  ],
  "risk": "high",
  "invocation": {
    "mode": "unary",
    "idempotency": "supported",
    "cancellable": true,
    "resumable": false
  },
  "resources": {
    "timeoutMs": 120000,
    "maxOutputBytes": 4194304,
    "maxAttempts": 1
  },
  "discovery": {
    "intents": [
      "move to trash"
    ],
    "contexts": [
      "general",
      "space",
      "requirement",
      "workflow",
      "schedule"
    ]
  }
}
