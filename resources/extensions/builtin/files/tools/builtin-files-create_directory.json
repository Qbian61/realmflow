{
  "schemaVersion": 1,
  "id": "builtin.files.create_directory",
  "version": "1.3.2",
  "name": "Create directory",
  "description": "Create an authorized directory.",
  "tags": [
    "files"
  ],
  "executor": {
    "kind": "builtin",
    "handler": "files.create_directory",
    "handlerVersion": "1.0.0"
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "path",
      "expectedAbsent"
    ],
    "properties": {
      "path": {
        "type": "string",
        "minLength": 1,
        "description": "Authorized local path as a relative path under the authorized root. Do not invent or pass absolute local paths.",
        "examples": [
          "docs/example.md"
        ]
      },
      "scopeRoot": {
        "type": "string",
        "minLength": 1,
        "description": "Optional authorized root override. Omit or pass \".\" to use the current authorized root.",
        "examples": [
          "."
        ]
      },
      "expectedAbsent": {
        "type": "boolean",
        "const": true,
        "description": "Must be true to confirm the target path does not already exist.",
        "examples": [
          true
        ]
      }
    },
    "examples": [
      {
        "path": "docs/example.md",
        "scopeRoot": ".",
        "expectedAbsent": true
      }
    ]
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": true
  },
  "capabilities": [
    "filesystem.write"
  ],
  "effects": [
    "local_data.change"
  ],
  "risk": "medium",
  "invocation": {
    "mode": "unary",
    "idempotency": "supported",
    "cancellable": true,
    "resumable": false
  },
  "resources": {
    "timeoutMs": 120000,
    "maxOutputBytes": 4194304,
    "maxAttempts": 1
  },
  "discovery": {
    "intents": [
      "create directory"
    ],
    "contexts": [
      "general",
      "space",
      "requirement",
      "workflow",
      "schedule"
    ]
  }
}
