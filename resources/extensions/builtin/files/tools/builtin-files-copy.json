{
  "schemaVersion": 1,
  "id": "builtin.files.copy",
  "version": "1.3.2",
  "name": "Copy files",
  "description": "Copy an authorized file or directory.",
  "tags": [
    "files"
  ],
  "executor": {
    "kind": "builtin",
    "handler": "files.copy",
    "handlerVersion": "1.0.0"
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "sourcePath",
      "targetPath",
      "expectedChecksum",
      "expectedAbsent"
    ],
    "properties": {
      "sourcePath": {
        "type": "string",
        "minLength": 1,
        "description": "Authorized source path as a relative path under the authorized root. Do not invent or pass absolute local paths.",
        "examples": [
          "docs/source.docx"
        ]
      },
      "targetPath": {
        "type": "string",
        "minLength": 1,
        "description": "Authorized destination path as a relative path under the authorized root. Do not invent or pass absolute local paths.",
        "examples": [
          "docs/copy.md"
        ]
      },
      "expectedChecksum": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$",
        "description": "SHA-256 checksum of the authorized prior file content.",
        "examples": [
          "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        ]
      },
      "expectedAbsent": {
        "type": "boolean",
        "const": true,
        "description": "Must be true to confirm the target path does not already exist.",
        "examples": [
          true
        ]
      },
      "scopeRoot": {
        "type": "string",
        "minLength": 1,
        "description": "Optional authorized root override. Omit or pass \".\" to use the current authorized root.",
        "examples": [
          "."
        ]
      }
    },
    "examples": [
      {
        "sourcePath": "docs/source.docx",
        "targetPath": "docs/copy.md",
        "expectedChecksum": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "expectedAbsent": true,
        "scopeRoot": "."
      }
    ]
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": true
  },
  "capabilities": [
    "filesystem.write"
  ],
  "effects": [
    "local_data.change"
  ],
  "risk": "medium",
  "invocation": {
    "mode": "unary",
    "idempotency": "supported",
    "cancellable": true,
    "resumable": false
  },
  "resources": {
    "timeoutMs": 120000,
    "maxOutputBytes": 4194304,
    "maxAttempts": 1
  },
  "discovery": {
    "intents": [
      "copy files"
    ],
    "contexts": [
      "general",
      "space",
      "requirement",
      "workflow",
      "schedule"
    ]
  }
}
