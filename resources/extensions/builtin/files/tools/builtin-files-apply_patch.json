{
  "schemaVersion": 1,
  "id": "builtin.files.apply_patch",
  "version": "1.3.1",
  "name": "Apply patch",
  "description": "Apply a patch with prior-content validation.",
  "tags": [
    "files"
  ],
  "executor": {
    "kind": "builtin",
    "handler": "files.apply_patch",
    "handlerVersion": "1.0.0"
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "path",
      "expectedChecksum",
      "edits"
    ],
    "properties": {
      "path": {
        "type": "string",
        "minLength": 1
      },
      "scopeRoot": {
        "type": "string",
        "minLength": 1
      },
      "expectedChecksum": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "edits": {
        "type": "array",
        "minItems": 1,
        "maxItems": 100,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "oldText",
            "newText"
          ],
          "properties": {
            "oldText": {
              "type": "string",
              "minLength": 1
            },
            "newText": {
              "type": "string"
            },
            "replaceAll": {
              "type": "boolean"
            }
          }
        }
      }
    }
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": true
  },
  "capabilities": [
    "filesystem.write"
  ],
  "effects": [
    "local_data.change"
  ],
  "risk": "medium",
  "invocation": {
    "mode": "unary",
    "idempotency": "supported",
    "cancellable": true,
    "resumable": false
  },
  "resources": {
    "timeoutMs": 120000,
    "maxOutputBytes": 4194304,
    "maxAttempts": 1
  },
  "discovery": {
    "intents": [
      "apply patch"
    ],
    "contexts": [
      "general",
      "space",
      "requirement",
      "workflow",
      "schedule"
    ]
  }
}
