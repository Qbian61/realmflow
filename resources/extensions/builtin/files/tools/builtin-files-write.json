{
  "schemaVersion": 1,
  "id": "builtin.files.write",
  "version": "1.3.2",
  "name": "Write file",
  "description": "Atomically create or replace a file.",
  "tags": [
    "files"
  ],
  "executor": {
    "kind": "builtin",
    "handler": "files.write",
    "handlerVersion": "1.0.0"
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "path",
      "mode",
      "content"
    ],
    "properties": {
      "path": {
        "type": "string",
        "minLength": 1,
        "description": "Authorized local path as a relative path under the authorized root. Do not invent or pass absolute local paths.",
        "examples": [
          "docs/example.md"
        ]
      },
      "scopeRoot": {
        "type": "string",
        "minLength": 1,
        "description": "Optional authorized root override. Omit or pass \".\" to use the current authorized root.",
        "examples": [
          "."
        ]
      },
      "mode": {
        "type": "string",
        "enum": [
          "create",
          "replace"
        ],
        "description": "Operation mode selected for this tool call. Allowed values: create, replace.",
        "examples": [
          "create"
        ]
      },
      "content": {
        "type": "string",
        "description": "UTF-8 text content to write into the authorized local file.",
        "examples": [
          "Example content."
        ]
      },
      "expectedChecksum": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$",
        "description": "SHA-256 checksum of the authorized prior file content.",
        "examples": [
          "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        ]
      },
      "expectedAbsent": {
        "type": "boolean",
        "const": true,
        "description": "Must be true to confirm the target path does not already exist.",
        "examples": [
          true
        ]
      }
    },
    "allOf": [
      {
        "if": {
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "const": "create"
            }
          }
        },
        "then": {
          "required": [
            "expectedAbsent"
          ]
        },
        "else": {
          "required": [
            "expectedChecksum"
          ]
        }
      }
    ],
    "examples": [
      {
        "path": "docs/example.md",
        "scopeRoot": ".",
        "mode": "create",
        "content": "Example content.",
        "expectedChecksum": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "expectedAbsent": true
      }
    ]
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": true
  },
  "capabilities": [
    "filesystem.write"
  ],
  "effects": [
    "local_data.change"
  ],
  "risk": "medium",
  "invocation": {
    "mode": "unary",
    "idempotency": "supported",
    "cancellable": true,
    "resumable": false
  },
  "resources": {
    "timeoutMs": 120000,
    "maxOutputBytes": 4194304,
    "maxAttempts": 1
  },
  "discovery": {
    "intents": [
      "write file"
    ],
    "contexts": [
      "general",
      "space",
      "requirement",
      "workflow",
      "schedule"
    ]
  }
}
