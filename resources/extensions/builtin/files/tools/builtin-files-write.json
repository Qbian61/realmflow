{
  "schemaVersion": 1,
  "id": "builtin.files.write",
  "version": "1.3.1",
  "name": "Write file",
  "description": "Atomically create or replace a file.",
  "tags": [
    "files"
  ],
  "executor": {
    "kind": "builtin",
    "handler": "files.write",
    "handlerVersion": "1.0.0"
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "path",
      "mode",
      "content"
    ],
    "properties": {
      "path": {
        "type": "string",
        "minLength": 1
      },
      "scopeRoot": {
        "type": "string",
        "minLength": 1
      },
      "mode": {
        "type": "string",
        "enum": [
          "create",
          "replace"
        ]
      },
      "content": {
        "type": "string"
      },
      "expectedChecksum": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "expectedAbsent": {
        "type": "boolean",
        "const": true
      }
    },
    "allOf": [
      {
        "if": {
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "const": "create"
            }
          }
        },
        "then": {
          "required": [
            "expectedAbsent"
          ]
        },
        "else": {
          "required": [
            "expectedChecksum"
          ]
        }
      }
    ]
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": true
  },
  "capabilities": [
    "filesystem.write"
  ],
  "effects": [
    "local_data.change"
  ],
  "risk": "medium",
  "invocation": {
    "mode": "unary",
    "idempotency": "supported",
    "cancellable": true,
    "resumable": false
  },
  "resources": {
    "timeoutMs": 120000,
    "maxOutputBytes": 4194304,
    "maxAttempts": 1
  },
  "discovery": {
    "intents": [
      "write file"
    ],
    "contexts": [
      "general",
      "space",
      "requirement",
      "workflow",
      "schedule"
    ]
  }
}
