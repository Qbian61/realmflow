{
  "schemaVersion": 1,
  "id": "builtin.files.search",
  "version": "1.3.1",
  "name": "Search files",
  "description": "Search authorized files by name or content.",
  "tags": [
    "files"
  ],
  "executor": {
    "kind": "builtin",
    "handler": "files.search",
    "handlerVersion": "1.0.0"
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "query"
    ],
    "properties": {
      "path": {
        "type": "string",
        "minLength": 1
      },
      "scopeRoot": {
        "type": "string",
        "minLength": 1
      },
      "query": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "mode": {
        "type": "string",
        "enum": [
          "name",
          "content"
        ]
      },
      "maxResults": {
        "type": "integer",
        "minimum": 1,
        "maximum": 200
      }
    }
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": true
  },
  "capabilities": [
    "filesystem.read"
  ],
  "effects": [
    "local_data.read"
  ],
  "risk": "low",
  "invocation": {
    "mode": "unary",
    "idempotency": "supported",
    "cancellable": true,
    "resumable": false
  },
  "resources": {
    "timeoutMs": 120000,
    "maxOutputBytes": 4194304,
    "maxAttempts": 1
  },
  "discovery": {
    "intents": [
      "search files"
    ],
    "contexts": [
      "general",
      "space",
      "requirement",
      "workflow",
      "schedule"
    ]
  }
}
