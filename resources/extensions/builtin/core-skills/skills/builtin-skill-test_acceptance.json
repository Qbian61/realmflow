{
  "schemaVersion": 1,
  "id": "builtin.skill.test_acceptance",
  "version": "1.0.2",
  "name": "Test acceptance",
  "description": "Run tests, inspect results, and produce acceptance evidence.",
  "instructionsPath": "instructions/test_acceptance.md",
  "runtime": {
    "kind": "instruction"
  },
  "inputSchema": {
    "type": "object",
    "description": "Inputs for invoking the Test acceptance Skill.",
    "required": [
      "task"
    ],
    "additionalProperties": false,
    "properties": {
      "task": {
        "type": "string",
        "description": "The user-visible task or workflow objective for the Skill.",
        "minLength": 1
      },
      "context": {
        "type": "string",
        "description": "Optional local context that narrows the requested work.",
        "minLength": 1
      }
    }
  },
  "outputSchema": {
    "type": "object",
    "description": "Structured result produced by the Test acceptance Skill.",
    "required": [
      "summary"
    ],
    "additionalProperties": false,
    "properties": {
      "summary": {
        "type": "string",
        "description": "Concise outcome summary for the completed Skill run.",
        "minLength": 1
      }
    }
  },
  "examples": [
    {
      "task": "Run test acceptance for the current request."
    }
  ],
  "requiredTools": [
    {
      "toolId": "builtin.process.run",
      "versionRange": "^1.0.0",
      "required": true
    },
    {
      "toolId": "builtin.files.read",
      "versionRange": "^1.0.0",
      "required": true
    },
    {
      "toolId": "builtin.computer.observe",
      "versionRange": "^1.0.0",
      "required": true
    }
  ],
  "activation": {
    "intents": [
      "test acceptance"
    ],
    "contexts": [
      "general",
      "space",
      "requirement",
      "workflow",
      "schedule"
    ]
  },
  "limits": {
    "maxToolCalls": 64,
    "timeoutMs": 900000
  }
}
