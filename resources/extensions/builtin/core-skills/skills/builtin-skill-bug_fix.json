{
  "schemaVersion": 1,
  "id": "builtin.skill.bug_fix",
  "version": "1.0.0",
  "name": "Bug fix",
  "description": "Reproduce, diagnose, repair, and regression-test a defect.",
  "instructionsPath": "instructions/bug_fix.md",
  "runtime": {
    "kind": "instruction"
  },
  "inputSchema": {
    "type": "object",
    "description": "Inputs for invoking the Bug fix Skill.",
    "required": [
      "task"
    ],
    "additionalProperties": false,
    "properties": {
      "task": {
        "type": "string",
        "description": "The user-visible task or workflow objective for the Skill.",
        "minLength": 1
      },
      "context": {
        "type": "string",
        "description": "Optional local context that narrows the requested work.",
        "minLength": 1
      }
    }
  },
  "outputSchema": {
    "type": "object",
    "description": "Structured result produced by the Bug fix Skill.",
    "required": [
      "summary"
    ],
    "additionalProperties": false,
    "properties": {
      "summary": {
        "type": "string",
        "description": "Concise outcome summary for the completed Skill run.",
        "minLength": 1
      }
    }
  },
  "examples": [
    {
      "task": "Run bug fix for the current request."
    }
  ],
  "requiredTools": [
    {
      "toolId": "builtin.files.read",
      "versionRange": "^1.0.0",
      "required": true
    },
    {
      "toolId": "builtin.files.search",
      "versionRange": "^1.0.0",
      "required": true
    },
    {
      "toolId": "builtin.files.apply_patch",
      "versionRange": "^1.0.0",
      "required": true
    },
    {
      "toolId": "builtin.git.diff",
      "versionRange": "^1.0.0",
      "required": true
    },
    {
      "toolId": "builtin.process.run",
      "versionRange": "^1.0.0",
      "required": true
    },
    {
      "toolId": "builtin.knowledge.search",
      "versionRange": "^1.0.0",
      "required": true
    }
  ],
  "activation": {
    "intents": [
      "bug fix"
    ],
    "contexts": [
      "general",
      "space",
      "requirement",
      "workflow",
      "schedule"
    ]
  },
  "limits": {
    "maxToolCalls": 64,
    "timeoutMs": 900000
  }
}
