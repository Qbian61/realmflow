{
  "schemaVersion": 1,
  "id": "builtin.skill.workflow_recovery",
  "version": "1.0.2",
  "name": "Workflow recovery",
  "description": "Inspect failures, plan recovery, and retry without bypassing gates.",
  "instructionsPath": "instructions/workflow_recovery.md",
  "runtime": {
    "kind": "instruction"
  },
  "inputSchema": {
    "type": "object",
    "description": "Inputs for invoking the Workflow recovery Skill.",
    "required": [
      "task"
    ],
    "additionalProperties": false,
    "properties": {
      "task": {
        "type": "string",
        "description": "The user-visible task or workflow objective for the Skill.",
        "minLength": 1
      },
      "context": {
        "type": "string",
        "description": "Optional local context that narrows the requested work.",
        "minLength": 1
      }
    }
  },
  "outputSchema": {
    "type": "object",
    "description": "Structured result produced by the Workflow recovery Skill.",
    "required": [
      "summary"
    ],
    "additionalProperties": false,
    "properties": {
      "summary": {
        "type": "string",
        "description": "Concise outcome summary for the completed Skill run.",
        "minLength": 1
      }
    }
  },
  "examples": [
    {
      "task": "Run workflow recovery for the current request."
    }
  ],
  "requiredTools": [
    {
      "toolId": "builtin.realmflow.workflow.get_execution",
      "versionRange": "^1.0.0",
      "required": true
    },
    {
      "toolId": "builtin.process.list",
      "versionRange": "^1.0.0",
      "required": true
    },
    {
      "toolId": "builtin.knowledge.search",
      "versionRange": "^1.0.0",
      "required": true
    }
  ],
  "activation": {
    "intents": [
      "workflow recovery"
    ],
    "contexts": [
      "general",
      "space",
      "requirement",
      "workflow",
      "schedule"
    ]
  },
  "limits": {
    "maxToolCalls": 64,
    "timeoutMs": 900000
  }
}
