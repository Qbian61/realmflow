{
  "schemaVersion": 1,
  "id": "builtin.skill.release_preparation",
  "version": "1.0.0",
  "name": "Release preparation",
  "description": "Check changes, tests, builds, artifacts, and release gates.",
  "instructionsPath": "instructions/release_preparation.md",
  "runtime": {
    "kind": "instruction"
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": true
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": true
  },
  "requiredTools": [
    {
      "toolId": "builtin.git.status",
      "versionRange": "^1.0.0",
      "required": true
    },
    {
      "toolId": "builtin.git.diff",
      "versionRange": "^1.0.0",
      "required": true
    },
    {
      "toolId": "builtin.process.run",
      "versionRange": "^1.0.0",
      "required": true
    },
    {
      "toolId": "builtin.realmflow.artifacts.list",
      "versionRange": "^1.0.0",
      "required": true
    },
    {
      "toolId": "builtin.computer.observe",
      "versionRange": "^1.0.0",
      "required": true
    }
  ],
  "activation": {
    "intents": [
      "release preparation"
    ],
    "contexts": [
      "general",
      "space",
      "requirement",
      "workflow",
      "schedule"
    ]
  },
  "limits": {
    "maxToolCalls": 64,
    "timeoutMs": 900000
  }
}
