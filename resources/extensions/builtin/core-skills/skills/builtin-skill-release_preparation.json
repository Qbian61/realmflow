{
  "schemaVersion": 1,
  "id": "builtin.skill.release_preparation",
  "version": "1.0.0",
  "name": "Release preparation",
  "description": "Check changes, tests, builds, artifacts, and release gates.",
  "instructionsPath": "instructions/release_preparation.md",
  "runtime": {
    "kind": "instruction"
  },
  "inputSchema": {
    "type": "object",
    "description": "Inputs for invoking the Release preparation Skill.",
    "required": [
      "task"
    ],
    "additionalProperties": false,
    "properties": {
      "task": {
        "type": "string",
        "description": "The user-visible task or workflow objective for the Skill.",
        "minLength": 1
      },
      "context": {
        "type": "string",
        "description": "Optional local context that narrows the requested work.",
        "minLength": 1
      }
    }
  },
  "outputSchema": {
    "type": "object",
    "description": "Structured result produced by the Release preparation Skill.",
    "required": [
      "summary"
    ],
    "additionalProperties": false,
    "properties": {
      "summary": {
        "type": "string",
        "description": "Concise outcome summary for the completed Skill run.",
        "minLength": 1
      }
    }
  },
  "examples": [
    {
      "task": "Run release preparation for the current request."
    }
  ],
  "requiredTools": [
    {
      "toolId": "builtin.git.status",
      "versionRange": "^1.0.0",
      "required": true
    },
    {
      "toolId": "builtin.git.diff",
      "versionRange": "^1.0.0",
      "required": true
    },
    {
      "toolId": "builtin.process.run",
      "versionRange": "^1.0.0",
      "required": true
    },
    {
      "toolId": "builtin.realmflow.artifacts.list",
      "versionRange": "^1.0.0",
      "required": true
    },
    {
      "toolId": "builtin.computer.observe",
      "versionRange": "^1.0.0",
      "required": true
    }
  ],
  "activation": {
    "intents": [
      "release preparation"
    ],
    "contexts": [
      "general",
      "space",
      "requirement",
      "workflow",
      "schedule"
    ]
  },
  "limits": {
    "maxToolCalls": 64,
    "timeoutMs": 900000
  }
}
