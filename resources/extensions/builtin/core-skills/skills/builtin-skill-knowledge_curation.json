{
  "schemaVersion": 1,
  "id": "builtin.skill.knowledge_curation",
  "version": "1.0.2",
  "name": "Knowledge curation",
  "description": "Retrieve, distill, and save durable project knowledge.",
  "instructionsPath": "instructions/knowledge_curation.md",
  "runtime": {
    "kind": "instruction"
  },
  "inputSchema": {
    "type": "object",
    "description": "Inputs for invoking the Knowledge curation Skill.",
    "required": [
      "task"
    ],
    "additionalProperties": false,
    "properties": {
      "task": {
        "type": "string",
        "description": "The user-visible task or workflow objective for the Skill.",
        "minLength": 1
      },
      "context": {
        "type": "string",
        "description": "Optional local context that narrows the requested work.",
        "minLength": 1
      }
    }
  },
  "outputSchema": {
    "type": "object",
    "description": "Structured result produced by the Knowledge curation Skill.",
    "required": [
      "summary"
    ],
    "additionalProperties": false,
    "properties": {
      "summary": {
        "type": "string",
        "description": "Concise outcome summary for the completed Skill run.",
        "minLength": 1
      }
    }
  },
  "examples": [
    {
      "task": "Run knowledge curation for the current request."
    }
  ],
  "requiredTools": [
    {
      "toolId": "builtin.knowledge.search",
      "versionRange": "^1.0.0",
      "required": true
    },
    {
      "toolId": "builtin.knowledge.note.create",
      "versionRange": "^1.0.0",
      "required": true
    },
    {
      "toolId": "builtin.knowledge.note.edit",
      "versionRange": "^1.0.0",
      "required": true
    },
    {
      "toolId": "builtin.files.read",
      "versionRange": "^1.0.0",
      "required": true
    },
    {
      "toolId": "builtin.realmflow.artifacts.read",
      "versionRange": "^1.0.0",
      "required": true
    }
  ],
  "activation": {
    "intents": [
      "knowledge curation"
    ],
    "contexts": [
      "general",
      "space",
      "requirement",
      "workflow",
      "schedule"
    ]
  },
  "limits": {
    "maxToolCalls": 64,
    "timeoutMs": 900000
  }
}
