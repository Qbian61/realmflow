{
  "schemaVersion": 1,
  "id": "builtin.skill.knowledge_curation",
  "version": "1.0.0",
  "name": "Knowledge curation",
  "description": "Retrieve, distill, and save durable project knowledge.",
  "instructionsPath": "instructions/knowledge_curation.md",
  "runtime": {
    "kind": "instruction"
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": true
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": true
  },
  "requiredTools": [
    {
      "toolId": "builtin.knowledge.search",
      "versionRange": "^1.0.0",
      "required": true
    },
    {
      "toolId": "builtin.knowledge.note.save",
      "versionRange": "^1.0.0",
      "required": true
    },
    {
      "toolId": "builtin.files.read",
      "versionRange": "^1.0.0",
      "required": true
    },
    {
      "toolId": "builtin.realmflow.artifacts.read",
      "versionRange": "^1.0.0",
      "required": true
    }
  ],
  "activation": {
    "intents": [
      "knowledge curation"
    ],
    "contexts": [
      "general",
      "space",
      "requirement",
      "workflow",
      "schedule"
    ]
  },
  "limits": {
    "maxToolCalls": 64,
    "timeoutMs": 900000
  }
}
