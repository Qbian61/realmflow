{
  "schemaVersion": 1,
  "id": "builtin.skill.feature_implementation",
  "version": "1.0.0",
  "name": "Feature implementation",
  "description": "Implement a designed change and continuously verify it.",
  "instructionsPath": "instructions/feature_implementation.md",
  "runtime": {
    "kind": "instruction"
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": true
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": true
  },
  "requiredTools": [
    {
      "toolId": "builtin.files.read",
      "versionRange": "^1.0.0",
      "required": true
    },
    {
      "toolId": "builtin.files.write",
      "versionRange": "^1.0.0",
      "required": true
    },
    {
      "toolId": "builtin.files.apply_patch",
      "versionRange": "^1.0.0",
      "required": true
    },
    {
      "toolId": "builtin.git.diff",
      "versionRange": "^1.0.0",
      "required": true
    },
    {
      "toolId": "builtin.process.run",
      "versionRange": "^1.0.0",
      "required": true
    }
  ],
  "activation": {
    "intents": [
      "feature implementation"
    ],
    "contexts": [
      "general",
      "space",
      "requirement",
      "workflow",
      "schedule"
    ]
  },
  "limits": {
    "maxToolCalls": 64,
    "timeoutMs": 900000
  }
}
