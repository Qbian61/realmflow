{
  "schemaVersion": 1,
  "id": "builtin.skill.repository_onboarding",
  "version": "1.0.0",
  "name": "Repository onboarding",
  "description": "Identify architecture, tooling, rules, and entry points.",
  "instructionsPath": "instructions/repository_onboarding.md",
  "runtime": {
    "kind": "instruction"
  },
  "inputSchema": {
    "type": "object",
    "description": "Inputs for invoking the Repository onboarding Skill.",
    "required": [
      "task"
    ],
    "additionalProperties": false,
    "properties": {
      "task": {
        "type": "string",
        "description": "The user-visible task or workflow objective for the Skill.",
        "minLength": 1
      },
      "context": {
        "type": "string",
        "description": "Optional local context that narrows the requested work.",
        "minLength": 1
      }
    }
  },
  "outputSchema": {
    "type": "object",
    "description": "Structured result produced by the Repository onboarding Skill.",
    "required": [
      "summary"
    ],
    "additionalProperties": false,
    "properties": {
      "summary": {
        "type": "string",
        "description": "Concise outcome summary for the completed Skill run.",
        "minLength": 1
      }
    }
  },
  "examples": [
    {
      "task": "Run repository onboarding for the current request."
    }
  ],
  "requiredTools": [
    {
      "toolId": "builtin.files.search",
      "versionRange": "^1.0.0",
      "required": true
    },
    {
      "toolId": "builtin.files.read",
      "versionRange": "^1.0.0",
      "required": true
    },
    {
      "toolId": "builtin.git.log",
      "versionRange": "^1.0.0",
      "required": true
    },
    {
      "toolId": "builtin.process.discover",
      "versionRange": "^1.0.0",
      "required": true
    }
  ],
  "activation": {
    "intents": [
      "repository onboarding"
    ],
    "contexts": [
      "general",
      "space",
      "requirement",
      "workflow",
      "schedule"
    ]
  },
  "limits": {
    "maxToolCalls": 64,
    "timeoutMs": 900000
  }
}
