{
  "schemaVersion": 1,
  "id": "builtin.spreadsheet.chart",
  "version": "1.0.0",
  "name": "Add spreadsheet chart",
  "description": "Add a basic chart from explicit data and category ranges.",
  "tags": [
    "spreadsheet"
  ],
  "executor": {
    "kind": "builtin",
    "handler": "spreadsheet.chart",
    "handlerVersion": "1.0.0"
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "sessionId": {
        "type": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f-]{27,}$"
      },
      "expectedRevision": {
        "type": "integer",
        "minimum": 0
      },
      "sheet": {
        "type": "string",
        "minLength": 1,
        "maxLength": 255
      },
      "range": {
        "type": "string",
        "pattern": "^[A-Za-z]{1,3}[1-9][0-9]*:[A-Za-z]{1,3}[1-9][0-9]*$"
      },
      "type": {
        "type": "string",
        "enum": [
          "bar",
          "line",
          "pie"
        ]
      },
      "title": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "dataRange": {
        "type": "string",
        "pattern": "^[A-Za-z]{1,3}[1-9][0-9]*:[A-Za-z]{1,3}[1-9][0-9]*$"
      },
      "categoryRange": {
        "type": "string",
        "pattern": "^[A-Za-z]{1,3}[1-9][0-9]*:[A-Za-z]{1,3}[1-9][0-9]*$"
      },
      "anchor": {
        "type": "string",
        "pattern": "^[A-Za-z]{1,3}[1-9][0-9]*$"
      }
    },
    "required": [
      "sessionId",
      "expectedRevision",
      "sheet",
      "type",
      "title",
      "dataRange",
      "categoryRange",
      "anchor"
    ]
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": true
  },
  "capabilities": [
    "filesystem.write"
  ],
  "effects": [
    "local_data.change"
  ],
  "risk": "medium",
  "invocation": {
    "mode": "unary",
    "idempotency": "supported",
    "cancellable": true,
    "resumable": false
  },
  "resources": {
    "timeoutMs": 120000,
    "maxOutputBytes": 4194304,
    "maxAttempts": 1
  },
  "discovery": {
    "intents": [
      "add spreadsheet chart"
    ],
    "contexts": [
      "general",
      "space",
      "requirement",
      "workflow",
      "schedule"
    ]
  }
}
