{
  "schemaVersion": 1,
  "id": "builtin.spreadsheet.filter",
  "version": "1.0.1",
  "name": "Filter spreadsheet rows",
  "description": "Evaluate and persist a bounded spreadsheet filter.",
  "tags": [
    "spreadsheet"
  ],
  "executor": {
    "kind": "builtin",
    "handler": "spreadsheet.filter",
    "handlerVersion": "1.0.0"
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "sessionId": {
        "type": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f-]{27,}$",
        "description": "Stable local editing or browser session ID returned by an inspect/create tool.",
        "examples": [
          "12345678-1234-4234-9234-123456789abc"
        ]
      },
      "expectedRevision": {
        "type": "integer",
        "minimum": 0,
        "description": "Expected revision used for optimistic concurrency control. Copy this value from the latest RealmFlow UI/API state; do not invent it.",
        "examples": [
          1
        ]
      },
      "sheet": {
        "type": "string",
        "minLength": 1,
        "maxLength": 255,
        "description": "Spreadsheet sheet name.",
        "examples": [
          "Sheet1"
        ]
      },
      "range": {
        "type": "string",
        "pattern": "^[A-Za-z]{1,3}[1-9][0-9]*:[A-Za-z]{1,3}[1-9][0-9]*$",
        "description": "Spreadsheet A1 range affected by the operation.",
        "examples": [
          "A1:B2"
        ]
      },
      "column": {
        "type": "integer",
        "minimum": 1,
        "description": "One-based column index used by the spreadsheet operation.",
        "examples": [
          1
        ]
      },
      "operator": {
        "type": "string",
        "enum": [
          "equals",
          "not_equals",
          "contains"
        ],
        "description": "Comparison operator used by the spreadsheet filter. Allowed values: equals, not_equals, contains.",
        "examples": [
          "equals"
        ]
      },
      "value": {
        "type": [
          "string",
          "number",
          "boolean"
        ],
        "description": "Value used by the form, filter, or selection operation.",
        "examples": [
          "Example value"
        ]
      }
    },
    "required": [
      "sessionId",
      "expectedRevision",
      "sheet",
      "range",
      "column",
      "operator",
      "value"
    ],
    "examples": [
      {
        "sessionId": "12345678-1234-4234-9234-123456789abc",
        "expectedRevision": 1,
        "sheet": "Sheet1",
        "range": "A1:B2",
        "column": 1,
        "operator": "equals",
        "value": "Example value"
      }
    ]
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": true
  },
  "capabilities": [
    "filesystem.write"
  ],
  "effects": [
    "local_data.change"
  ],
  "risk": "low",
  "invocation": {
    "mode": "unary",
    "idempotency": "supported",
    "cancellable": true,
    "resumable": false
  },
  "resources": {
    "timeoutMs": 120000,
    "maxOutputBytes": 4194304,
    "maxAttempts": 1
  },
  "discovery": {
    "intents": [
      "filter spreadsheet rows"
    ],
    "contexts": [
      "general",
      "space",
      "requirement",
      "workflow",
      "schedule"
    ]
  }
}
