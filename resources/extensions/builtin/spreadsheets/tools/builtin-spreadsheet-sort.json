{
  "schemaVersion": 1,
  "id": "builtin.spreadsheet.sort",
  "version": "1.0.1",
  "name": "Sort spreadsheet rows",
  "description": "Sort a bounded range by explicit columns.",
  "tags": [
    "spreadsheet"
  ],
  "executor": {
    "kind": "builtin",
    "handler": "spreadsheet.sort",
    "handlerVersion": "1.0.0"
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "sessionId": {
        "type": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f-]{27,}$",
        "description": "Stable local editing or browser session ID returned by an inspect/create tool.",
        "examples": [
          "12345678-1234-4234-9234-123456789abc"
        ]
      },
      "expectedRevision": {
        "type": "integer",
        "minimum": 0,
        "description": "Expected revision used for optimistic concurrency control. Copy this value from the latest RealmFlow UI/API state; do not invent it.",
        "examples": [
          1
        ]
      },
      "sheet": {
        "type": "string",
        "minLength": 1,
        "maxLength": 255,
        "description": "Spreadsheet sheet name.",
        "examples": [
          "Sheet1"
        ]
      },
      "range": {
        "type": "string",
        "pattern": "^[A-Za-z]{1,3}[1-9][0-9]*:[A-Za-z]{1,3}[1-9][0-9]*$",
        "description": "Spreadsheet A1 range affected by the operation.",
        "examples": [
          "A1:B2"
        ]
      },
      "keys": {
        "type": "array",
        "minItems": 1,
        "maxItems": 16,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "column",
            "direction"
          ],
          "properties": {
            "column": {
              "type": "integer",
              "minimum": 1,
              "description": "One-based column index used by the spreadsheet operation.",
              "examples": [
                1
              ]
            },
            "direction": {
              "type": "string",
              "enum": [
                "ascending",
                "descending"
              ],
              "description": "Sort direction for the spreadsheet sort key. Allowed values: ascending, descending.",
              "examples": [
                "ascending"
              ]
            }
          },
          "examples": [
            [
              {
                "column": 1,
                "direction": "ascending"
              }
            ]
          ]
        },
        "description": "Ordered spreadsheet sort keys.",
        "examples": [
          [
            {
              "column": 1,
              "direction": "ascending"
            }
          ]
        ]
      }
    },
    "required": [
      "sessionId",
      "expectedRevision",
      "sheet",
      "range",
      "keys"
    ],
    "examples": [
      {
        "sessionId": "12345678-1234-4234-9234-123456789abc",
        "expectedRevision": 1,
        "sheet": "Sheet1",
        "range": "A1:B2",
        "keys": [
          {
            "column": 1,
            "direction": "ascending"
          }
        ]
      }
    ]
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": true
  },
  "capabilities": [
    "filesystem.write"
  ],
  "effects": [
    "local_data.change"
  ],
  "risk": "medium",
  "invocation": {
    "mode": "unary",
    "idempotency": "supported",
    "cancellable": true,
    "resumable": false
  },
  "resources": {
    "timeoutMs": 120000,
    "maxOutputBytes": 4194304,
    "maxAttempts": 1
  },
  "discovery": {
    "intents": [
      "sort spreadsheet rows"
    ],
    "contexts": [
      "general",
      "space",
      "requirement",
      "workflow",
      "schedule"
    ]
  }
}
