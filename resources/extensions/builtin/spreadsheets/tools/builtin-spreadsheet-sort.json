{
  "schemaVersion": 1,
  "id": "builtin.spreadsheet.sort",
  "version": "1.0.0",
  "name": "Sort spreadsheet rows",
  "description": "Sort a bounded range by explicit columns.",
  "tags": [
    "spreadsheet"
  ],
  "executor": {
    "kind": "builtin",
    "handler": "spreadsheet.sort",
    "handlerVersion": "1.0.0"
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "sessionId": {
        "type": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f-]{27,}$"
      },
      "expectedRevision": {
        "type": "integer",
        "minimum": 0
      },
      "sheet": {
        "type": "string",
        "minLength": 1,
        "maxLength": 255
      },
      "range": {
        "type": "string",
        "pattern": "^[A-Za-z]{1,3}[1-9][0-9]*:[A-Za-z]{1,3}[1-9][0-9]*$"
      },
      "keys": {
        "type": "array",
        "minItems": 1,
        "maxItems": 16,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "column",
            "direction"
          ],
          "properties": {
            "column": {
              "type": "integer",
              "minimum": 1
            },
            "direction": {
              "type": "string",
              "enum": [
                "ascending",
                "descending"
              ]
            }
          }
        }
      }
    },
    "required": [
      "sessionId",
      "expectedRevision",
      "sheet",
      "range",
      "keys"
    ]
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": true
  },
  "capabilities": [
    "filesystem.write"
  ],
  "effects": [
    "local_data.change"
  ],
  "risk": "medium",
  "invocation": {
    "mode": "unary",
    "idempotency": "supported",
    "cancellable": true,
    "resumable": false
  },
  "resources": {
    "timeoutMs": 120000,
    "maxOutputBytes": 4194304,
    "maxAttempts": 1
  },
  "discovery": {
    "intents": [
      "sort spreadsheet rows"
    ],
    "contexts": [
      "general",
      "space",
      "requirement",
      "workflow",
      "schedule"
    ]
  }
}
