{
  "schemaVersion": 1,
  "id": "builtin.spreadsheet.set_formula",
  "version": "1.0.0",
  "name": "Set spreadsheet formula",
  "description": "Write formulas and require verified recalculation before save.",
  "tags": [
    "spreadsheet"
  ],
  "executor": {
    "kind": "builtin",
    "handler": "spreadsheet.set_formula",
    "handlerVersion": "1.0.0"
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "sessionId": {
        "type": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f-]{27,}$",
        "description": "Stable local editing or browser session ID returned by an inspect/create tool.",
        "examples": [
          "12345678-1234-4234-9234-123456789abc"
        ]
      },
      "expectedRevision": {
        "type": "integer",
        "minimum": 0,
        "description": "Expected revision used for optimistic concurrency control. Copy this value from the latest RealmFlow UI/API state; do not invent it.",
        "examples": [
          1
        ]
      },
      "sheet": {
        "type": "string",
        "minLength": 1,
        "maxLength": 255,
        "description": "Spreadsheet sheet name.",
        "examples": [
          "Sheet1"
        ]
      },
      "range": {
        "type": "string",
        "pattern": "^[A-Za-z]{1,3}[1-9][0-9]*:[A-Za-z]{1,3}[1-9][0-9]*$",
        "description": "Spreadsheet A1 range affected by the operation.",
        "examples": [
          "A1:B2"
        ]
      },
      "formulas": {
        "type": "array",
        "minItems": 1,
        "maxItems": 10000,
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "examples": [
            [
              [
                "=SUM(A1:A2)"
              ]
            ]
          ]
        },
        "description": "Two-dimensional formula matrix written into the spreadsheet range.",
        "examples": [
          [
            [
              "=SUM(A1:A2)"
            ]
          ]
        ]
      }
    },
    "required": [
      "sessionId",
      "expectedRevision",
      "sheet",
      "range",
      "formulas"
    ],
    "examples": [
      {
        "sessionId": "12345678-1234-4234-9234-123456789abc",
        "expectedRevision": 1,
        "sheet": "Sheet1",
        "range": "A1:B2",
        "formulas": [
          [
            "=SUM(A1:A2)"
          ]
        ]
      }
    ]
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": true
  },
  "capabilities": [
    "filesystem.write"
  ],
  "effects": [
    "local_data.change"
  ],
  "risk": "medium",
  "invocation": {
    "mode": "unary",
    "idempotency": "supported",
    "cancellable": true,
    "resumable": false
  },
  "resources": {
    "timeoutMs": 120000,
    "maxOutputBytes": 4194304,
    "maxAttempts": 1
  },
  "discovery": {
    "intents": [
      "set spreadsheet formula"
    ],
    "contexts": [
      "general",
      "space",
      "requirement",
      "workflow",
      "schedule"
    ]
  }
}
