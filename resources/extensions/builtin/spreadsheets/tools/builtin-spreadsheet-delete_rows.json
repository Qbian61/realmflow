{
  "schemaVersion": 1,
  "id": "builtin.spreadsheet.delete_rows",
  "version": "1.0.0",
  "name": "Delete spreadsheet rows",
  "description": "Delete structural rows from a spreadsheet session.",
  "tags": [
    "spreadsheet"
  ],
  "executor": {
    "kind": "builtin",
    "handler": "spreadsheet.delete_rows",
    "handlerVersion": "1.0.0"
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "sessionId": {
        "type": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f-]{27,}$",
        "description": "Stable local editing or browser session ID returned by an inspect/create tool.",
        "examples": [
          "12345678-1234-4234-9234-123456789abc"
        ]
      },
      "expectedRevision": {
        "type": "integer",
        "minimum": 0,
        "description": "Expected revision used for optimistic concurrency control. Copy this value from the latest RealmFlow UI/API state; do not invent it.",
        "examples": [
          1
        ]
      },
      "sheet": {
        "type": "string",
        "minLength": 1,
        "maxLength": 255,
        "description": "Spreadsheet sheet name.",
        "examples": [
          "Sheet1"
        ]
      },
      "range": {
        "type": "string",
        "pattern": "^[A-Za-z]{1,3}[1-9][0-9]*:[A-Za-z]{1,3}[1-9][0-9]*$",
        "description": "Spreadsheet A1 range affected by the operation.",
        "examples": [
          "A1:B2"
        ]
      },
      "startRow": {
        "type": "integer",
        "minimum": 1,
        "description": "One-based starting row index.",
        "examples": [
          1
        ]
      },
      "count": {
        "type": "integer",
        "minimum": 1,
        "maximum": 10000,
        "description": "Number of rows affected by the spreadsheet operation.",
        "examples": [
          1
        ]
      }
    },
    "required": [
      "sessionId",
      "expectedRevision",
      "sheet",
      "startRow",
      "count"
    ],
    "examples": [
      {
        "sessionId": "12345678-1234-4234-9234-123456789abc",
        "expectedRevision": 1,
        "sheet": "Sheet1",
        "range": "A1:B2",
        "startRow": 1,
        "count": 1
      }
    ]
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": true
  },
  "capabilities": [
    "filesystem.write"
  ],
  "effects": [
    "local_data.change"
  ],
  "risk": "medium",
  "invocation": {
    "mode": "unary",
    "idempotency": "supported",
    "cancellable": true,
    "resumable": false
  },
  "resources": {
    "timeoutMs": 120000,
    "maxOutputBytes": 4194304,
    "maxAttempts": 1
  },
  "discovery": {
    "intents": [
      "delete spreadsheet rows"
    ],
    "contexts": [
      "general",
      "space",
      "requirement",
      "workflow",
      "schedule"
    ]
  }
}
