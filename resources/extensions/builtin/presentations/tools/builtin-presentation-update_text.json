{
  "schemaVersion": 1,
  "id": "builtin.presentation.update_text",
  "version": "1.0.1",
  "name": "Update presentation text",
  "description": "Replace text in a shape selected by stable ID.",
  "tags": [
    "presentation"
  ],
  "executor": {
    "kind": "builtin",
    "handler": "presentation.update_text",
    "handlerVersion": "1.0.0"
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "sessionId": {
        "type": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f-]{27,}$",
        "description": "Stable local editing or browser session ID returned by an inspect/create tool.",
        "examples": [
          "12345678-1234-4234-9234-123456789abc"
        ]
      },
      "expectedRevision": {
        "type": "integer",
        "minimum": 0,
        "description": "Expected revision used for optimistic concurrency control. Copy this value from the latest RealmFlow UI/API state; do not invent it.",
        "examples": [
          1
        ]
      },
      "shapeId": {
        "type": "string",
        "pattern": "^shape-[0-9]+-[0-9]+$",
        "description": "Stable presentation shape ID.",
        "examples": [
          "shape-1-1"
        ]
      },
      "text": {
        "type": "string",
        "maxLength": 100000,
        "description": "Text content used by the requested operation.",
        "examples": [
          "Example text."
        ]
      }
    },
    "required": [
      "sessionId",
      "expectedRevision",
      "shapeId",
      "text"
    ],
    "examples": [
      {
        "sessionId": "12345678-1234-4234-9234-123456789abc",
        "expectedRevision": 1,
        "shapeId": "shape-1-1",
        "text": "Example text."
      }
    ]
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": true
  },
  "capabilities": [
    "filesystem.write"
  ],
  "effects": [
    "local_data.change"
  ],
  "risk": "medium",
  "invocation": {
    "mode": "unary",
    "idempotency": "supported",
    "cancellable": true,
    "resumable": false
  },
  "resources": {
    "timeoutMs": 120000,
    "maxOutputBytes": 4194304,
    "maxAttempts": 1
  },
  "discovery": {
    "intents": [
      "update presentation text"
    ],
    "contexts": [
      "general",
      "space",
      "requirement",
      "workflow",
      "schedule"
    ]
  }
}
