{
  "schemaVersion": 1,
  "id": "builtin.presentation.table_write",
  "version": "1.0.0",
  "name": "Write presentation table",
  "description": "Write a bounded value matrix into a table shape.",
  "tags": [
    "presentation"
  ],
  "executor": {
    "kind": "builtin",
    "handler": "presentation.table_write",
    "handlerVersion": "1.0.0"
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "sessionId": {
        "type": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f-]{27,}$"
      },
      "expectedRevision": {
        "type": "integer",
        "minimum": 0
      },
      "shapeId": {
        "type": "string",
        "pattern": "^shape-[0-9]+-[0-9]+$"
      },
      "startRow": {
        "type": "integer",
        "minimum": 1
      },
      "startColumn": {
        "type": "integer",
        "minimum": 1
      },
      "values": {
        "type": "array",
        "minItems": 1,
        "maxItems": 100,
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          }
        }
      }
    },
    "required": [
      "sessionId",
      "expectedRevision",
      "shapeId",
      "startRow",
      "startColumn",
      "values"
    ]
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": true
  },
  "capabilities": [
    "filesystem.write"
  ],
  "effects": [
    "local_data.change"
  ],
  "risk": "medium",
  "invocation": {
    "mode": "unary",
    "idempotency": "supported",
    "cancellable": true,
    "resumable": false
  },
  "resources": {
    "timeoutMs": 120000,
    "maxOutputBytes": 4194304,
    "maxAttempts": 1
  },
  "discovery": {
    "intents": [
      "write presentation table"
    ],
    "contexts": [
      "general",
      "space",
      "requirement",
      "workflow",
      "schedule"
    ]
  }
}
