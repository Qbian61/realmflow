{
  "schemaVersion": 1,
  "id": "builtin.presentation.chart_write",
  "version": "1.0.0",
  "name": "Write presentation chart",
  "description": "Replace basic chart categories and series.",
  "tags": [
    "presentation"
  ],
  "executor": {
    "kind": "builtin",
    "handler": "presentation.chart_write",
    "handlerVersion": "1.0.0"
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "sessionId": {
        "type": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f-]{27,}$",
        "description": "Stable local editing or browser session ID returned by an inspect/create tool.",
        "examples": [
          "12345678-1234-4234-9234-123456789abc"
        ]
      },
      "expectedRevision": {
        "type": "integer",
        "minimum": 0,
        "description": "Expected revision used for optimistic concurrency control. Copy this value from the latest RealmFlow UI/API state; do not invent it.",
        "examples": [
          1
        ]
      },
      "shapeId": {
        "type": "string",
        "pattern": "^shape-[0-9]+-[0-9]+$",
        "description": "Stable presentation shape ID.",
        "examples": [
          "shape-1-1"
        ]
      },
      "title": {
        "type": "string",
        "maxLength": 255,
        "description": "User-visible title.",
        "examples": [
          "Quarterly update"
        ]
      },
      "categories": {
        "type": "array",
        "minItems": 1,
        "maxItems": 1000,
        "items": {
          "type": [
            "string",
            "number"
          ],
          "examples": [
            [
              "Q1"
            ]
          ]
        },
        "description": "Ordered category labels used by the chart data series.",
        "examples": [
          [
            "Q1"
          ]
        ]
      },
      "series": {
        "type": "array",
        "minItems": 1,
        "maxItems": 100,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "values"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255,
              "description": "Display name or identifier used by the requested operation.",
              "examples": [
                "example"
              ]
            },
            "values": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1000,
              "items": {
                "type": "number",
                "examples": [
                  [
                    [
                      "Example value"
                    ]
                  ]
                ]
              },
              "description": "Two-dimensional value matrix written into the target range.",
              "examples": [
                [
                  [
                    "Example value"
                  ]
                ]
              ]
            }
          },
          "examples": [
            [
              {
                "name": "Revenue",
                "values": [
                  100
                ]
              }
            ]
          ]
        },
        "description": "Ordered chart data series.",
        "examples": [
          [
            {
              "name": "Revenue",
              "values": [
                100
              ]
            }
          ]
        ]
      }
    },
    "required": [
      "sessionId",
      "expectedRevision",
      "shapeId",
      "title",
      "categories",
      "series"
    ],
    "examples": [
      {
        "sessionId": "12345678-1234-4234-9234-123456789abc",
        "expectedRevision": 1,
        "shapeId": "shape-1-1",
        "title": "Quarterly update",
        "categories": [
          "Q1"
        ],
        "series": [
          {
            "name": "Revenue",
            "values": [
              100
            ]
          }
        ]
      }
    ]
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": true
  },
  "capabilities": [
    "filesystem.write"
  ],
  "effects": [
    "local_data.change"
  ],
  "risk": "medium",
  "invocation": {
    "mode": "unary",
    "idempotency": "supported",
    "cancellable": true,
    "resumable": false
  },
  "resources": {
    "timeoutMs": 120000,
    "maxOutputBytes": 4194304,
    "maxAttempts": 1
  },
  "discovery": {
    "intents": [
      "write presentation chart"
    ],
    "contexts": [
      "general",
      "space",
      "requirement",
      "workflow",
      "schedule"
    ]
  }
}
