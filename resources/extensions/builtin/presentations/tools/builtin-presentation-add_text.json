{
  "schemaVersion": 1,
  "id": "builtin.presentation.add_text",
  "version": "1.0.0",
  "name": "Add presentation text",
  "description": "Add a bounded text box to a slide.",
  "tags": [
    "presentation"
  ],
  "executor": {
    "kind": "builtin",
    "handler": "presentation.add_text",
    "handlerVersion": "1.0.0"
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "sessionId": {
        "type": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f-]{27,}$",
        "description": "Stable local editing or browser session ID returned by an inspect/create tool.",
        "examples": [
          "12345678-1234-4234-9234-123456789abc"
        ]
      },
      "expectedRevision": {
        "type": "integer",
        "minimum": 0,
        "description": "Expected revision used for optimistic concurrency control. Copy this value from the latest RealmFlow UI/API state; do not invent it.",
        "examples": [
          1
        ]
      },
      "slideId": {
        "type": "string",
        "pattern": "^slide-[0-9]+$",
        "description": "Stable presentation slide ID.",
        "examples": [
          "slide-1"
        ]
      },
      "text": {
        "type": "string",
        "maxLength": 100000,
        "description": "Text content used by the requested operation.",
        "examples": [
          "Example text."
        ]
      },
      "bounds": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "leftPt",
          "topPt",
          "widthPt",
          "heightPt"
        ],
        "properties": {
          "leftPt": {
            "type": "number",
            "minimum": 0,
            "maximum": 2880,
            "description": "Left coordinate in points within the target slide.",
            "examples": [
              0
            ]
          },
          "topPt": {
            "type": "number",
            "minimum": 0,
            "maximum": 2880,
            "description": "Top coordinate in points within the target slide.",
            "examples": [
              0
            ]
          },
          "widthPt": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 2880,
            "description": "Width in points.",
            "examples": [
              960
            ]
          },
          "heightPt": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 2880,
            "description": "Height in points.",
            "examples": [
              720
            ]
          }
        },
        "description": "Rectangle position and size in points within the target slide.",
        "examples": [
          {
            "leftPt": 24,
            "topPt": 24,
            "widthPt": 320,
            "heightPt": 180
          }
        ]
      }
    },
    "required": [
      "sessionId",
      "expectedRevision",
      "slideId",
      "text",
      "bounds"
    ],
    "examples": [
      {
        "sessionId": "12345678-1234-4234-9234-123456789abc",
        "expectedRevision": 1,
        "slideId": "slide-1",
        "text": "Example text.",
        "bounds": {
          "leftPt": 24,
          "topPt": 24,
          "widthPt": 320,
          "heightPt": 180
        }
      }
    ]
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": true
  },
  "capabilities": [
    "filesystem.write"
  ],
  "effects": [
    "local_data.change"
  ],
  "risk": "medium",
  "invocation": {
    "mode": "unary",
    "idempotency": "supported",
    "cancellable": true,
    "resumable": false
  },
  "resources": {
    "timeoutMs": 120000,
    "maxOutputBytes": 4194304,
    "maxAttempts": 1
  },
  "discovery": {
    "intents": [
      "add presentation text"
    ],
    "contexts": [
      "general",
      "space",
      "requirement",
      "workflow",
      "schedule"
    ]
  }
}
