{
  "schemaVersion": 1,
  "id": "builtin.presentation.delete_slide",
  "version": "1.0.0",
  "name": "Delete presentation slide",
  "description": "Delete a slide while retaining at least one slide.",
  "tags": [
    "presentation"
  ],
  "executor": {
    "kind": "builtin",
    "handler": "presentation.delete_slide",
    "handlerVersion": "1.0.0"
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "sessionId": {
        "type": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f-]{27,}$"
      },
      "expectedRevision": {
        "type": "integer",
        "minimum": 0
      },
      "slideId": {
        "type": "string",
        "pattern": "^slide-[0-9]+$"
      }
    },
    "required": [
      "sessionId",
      "expectedRevision",
      "slideId"
    ]
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": true
  },
  "capabilities": [
    "filesystem.write"
  ],
  "effects": [
    "local_data.change"
  ],
  "risk": "high",
  "invocation": {
    "mode": "unary",
    "idempotency": "supported",
    "cancellable": true,
    "resumable": false
  },
  "resources": {
    "timeoutMs": 120000,
    "maxOutputBytes": 4194304,
    "maxAttempts": 1
  },
  "discovery": {
    "intents": [
      "delete presentation slide"
    ],
    "contexts": [
      "general",
      "space",
      "requirement",
      "workflow",
      "schedule"
    ]
  }
}
