{
  "schemaVersion": 1,
  "id": "builtin.presentation.inspect",
  "version": "1.0.0",
  "name": "Inspect presentation",
  "description": "Open and inspect an authorized PPTX file.",
  "tags": [
    "presentation"
  ],
  "executor": {
    "kind": "builtin",
    "handler": "presentation.inspect",
    "handlerVersion": "1.0.0"
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "path"
    ],
    "properties": {
      "path": {
        "type": "string",
        "minLength": 1
      },
      "scopeRoot": {
        "type": "string",
        "minLength": 1
      },
      "mode": {
        "type": "string",
        "enum": [
          "read",
          "edit"
        ]
      }
    }
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": true
  },
  "capabilities": [
    "filesystem.read"
  ],
  "effects": [
    "local_data.read"
  ],
  "risk": "low",
  "invocation": {
    "mode": "unary",
    "idempotency": "supported",
    "cancellable": true,
    "resumable": false
  },
  "resources": {
    "timeoutMs": 120000,
    "maxOutputBytes": 4194304,
    "maxAttempts": 1
  },
  "discovery": {
    "intents": [
      "inspect presentation"
    ],
    "contexts": [
      "general",
      "space",
      "requirement",
      "workflow",
      "schedule"
    ]
  }
}
